{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Something app",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Something.App/bin/Debug/net10.0-windows10.0.26100.0/win-x64/Something.App.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole"
    },
    {
      "name": "Something app (demo)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Something.App/bin/Debug/net10.0-windows10.0.26100.0/win-x64/Something.App.dll",
      "args": ["--demo"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole"
    },
    {
      "name": "Inspect raw MFT dump",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/tools/Something.MftInspect/bin/Debug/net10.0/Something.MftInspect.dll",
      "args": ["${input:mftDumpPath}", "${input:recordSize}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    { "id": "mftDumpPath", "type": "promptString", "description": "Path to an offline raw $MFT dump" },
    { "id": "recordSize", "type": "promptString", "description": "NTFS file record size in bytes", "default": "1024" }
  ]
}
