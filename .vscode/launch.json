{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Inspect raw MFT dump",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/tools/Something.MftInspect/bin/Debug/net10.0/Something.MftInspect.dll",
      "args": ["${input:mftDumpPath}", "${input:recordSize}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "DOTNET_ROOT": "${workspaceFolder}/.tools/dotnet" }
    }
  ],
  "inputs": [
    { "id": "mftDumpPath", "type": "promptString", "description": "Path to an offline raw $MFT dump" },
    { "id": "recordSize", "type": "promptString", "description": "NTFS file record size in bytes", "default": "1024" }
  ]
}
