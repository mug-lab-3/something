{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "format",
      "type": "process",
      "command": "dotnet",
      "args": ["csharpier", "format", ".", "--no-cache", "--ignore-path", ".csharpierignore"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "format check",
      "type": "process",
      "command": "dotnet",
      "args": ["csharpier", "check", ".", "--ignore-path", ".csharpierignore"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "Something.slnx"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "--solution", "Something.slnx"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "test with coverage",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "--solution", "Something.slnx", "--coverage", "--coverage-output-format", "cobertura", "--coverage-settings", "tests/coverage.runsettings", "--results-directory", "artifacts/test-results"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "group": "test"
    }
  ]
}
