{
  "dotnet.defaultSolution": "Something.slnx",
  "[csharp]": {
    "editor.defaultFormatter": "csharpier.csharpier-vscode",
    "editor.formatOnSave": true
  },
  "terminal.integrated.env.windows": {
    "DOTNET_ROOT": "${workspaceFolder}\\.tools\\dotnet",
    "PATH": "${workspaceFolder}\\.tools\\dotnet;${env:PATH}"
  },
  "files.exclude": {
    "**/bin": true,
    "**/obj": true
  }
}
