<Window
  x:Class="Something.App.AnimationPreviewWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Something.App"
>
  <Grid
    x:Name="Root"
    Padding="24"
    RowSpacing="20"
    RequestedTheme="Dark"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
  >
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Spacing="12">
      <TextBlock x:Uid="AnimationPreview_Title" FontSize="22" FontWeight="SemiBold" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <ComboBox x:Name="KindBox" Width="200" SelectionChanged="OnKindChanged">
          <ComboBoxItem x:Uid="AnimationPreview_ModeLoading" />
          <ComboBoxItem x:Uid="AnimationPreview_ModeScan" />
          <ComboBoxItem x:Uid="AnimationPreview_ModeDeleteHistory" />
          <ComboBoxItem x:Uid="AnimationPreview_ModeOptimize" />
          <ComboBoxItem x:Uid="AnimationPreview_ModeExport" />
        </ComboBox>
        <ComboBox x:Name="ThemeBox" Width="120" SelectedIndex="0" SelectionChanged="OnThemeChanged">
          <ComboBoxItem x:Uid="AnimationPreview_ThemeDark" />
          <ComboBoxItem x:Uid="AnimationPreview_ThemeLight" />
        </ComboBox>
        <CheckBox x:Uid="AnimationPreview_StaticBox" x:Name="StaticBox" Click="OnStaticChanged" />
      </StackPanel>
    </StackPanel>
    <Viewbox Grid.Row="1" MaxWidth="480" MaxHeight="272">
      <Grid Width="420" Height="200">
        <local:RecordLoadingAnimation
          x:Name="Animation"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
        />
      </Grid>
    </Viewbox>
    <StackPanel Grid.Row="2" Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Uid="AnimationPreview_RestartButton" Click="OnRestart" />
        <ToggleButton x:Uid="AnimationPreview_PauseButton" x:Name="PauseButton" Click="OnPause" />
        <Button x:Uid="AnimationPreview_FinishButton" Click="OnFinish" />
      </StackPanel>
      <TextBlock
        x:Uid="AnimationPreview_StateText"
        x:Name="StateText"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
      />
    </StackPanel>
  </Grid>
</Window>
