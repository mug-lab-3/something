<Window
  x:Class="Something.App.AnimationPreviewWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Something.App"
>
  <Grid
    x:Name="Root"
    Padding="24"
    RowSpacing="20"
    RequestedTheme="Dark"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
  >
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Spacing="12">
      <TextBlock Text="アニメーションプレビュー" FontSize="22" FontWeight="SemiBold" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <ComboBox x:Name="KindBox" Width="200" SelectionChanged="OnKindChanged">
          <ComboBoxItem Content="読み込み" />
          <ComboBoxItem Content="スキャン" />
          <ComboBoxItem Content="履歴削除" />
          <ComboBoxItem Content="DB最適化" />
        </ComboBox>
        <ComboBox x:Name="ThemeBox" Width="120" SelectedIndex="0" SelectionChanged="OnThemeChanged">
          <ComboBoxItem Content="ダーク" />
          <ComboBoxItem Content="ライト" />
        </ComboBox>
        <CheckBox x:Name="StaticBox" Content="静止表示" Click="OnStaticChanged" />
      </StackPanel>
    </StackPanel>
    <Viewbox Grid.Row="1" MaxWidth="480" MaxHeight="272">
      <local:RecordLoadingAnimation x:Name="Animation" />
    </Viewbox>
    <StackPanel Grid.Row="2" Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="最初から再生" Click="OnRestart" />
        <ToggleButton x:Name="PauseButton" Content="一時停止" Click="OnPause" />
        <Button Content="区切りまで再生して停止" Click="OnFinish" />
      </StackPanel>
      <TextBlock
        x:Name="StateText"
        Text="再生中"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
      />
    </StackPanel>
  </Grid>
</Window>
