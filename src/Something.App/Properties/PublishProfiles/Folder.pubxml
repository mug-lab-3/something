<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- A folder layout installed under Program Files. A self-extracting single file would load
         its DLLs from %TEMP%, which non-elevated processes can modify before this elevated app runs. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
  </PropertyGroup>
  <Target Name="PrepareFolderContent" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
      <!-- WinUI adds these to build output; the .NET publisher does not include them automatically. -->
      <ResolvedFileToPublish Include="$(TargetDir)$(TargetName).pri" Condition="Exists('$(TargetDir)$(TargetName).pri')">
        <RelativePath>$(TargetName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <_FolderXamlResources Include="$(TargetDir)**/*.xbf" />
      <ResolvedFileToPublish Include="@(_FolderXamlResources)">
        <RelativePath>%(_FolderXamlResources.RecursiveDir)%(_FolderXamlResources.Filename)%(_FolderXamlResources.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
