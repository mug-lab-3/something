<UserControl
  x:Class="Something.App.DriveCard"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <Grid>
    <Button
      x:Name="CardButton"
      Click="OnInvoked"
      HorizontalContentAlignment="Stretch"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      Padding="18"
      CornerRadius="12"
      BorderThickness="1"
      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
    >
      <Grid ColumnSpacing="20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="8">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xEDA2;" FontSize="26" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1">
              <TextBlock x:Name="LabelText" TextTrimming="CharacterEllipsis" Margin="0,0,32,0" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock x:Name="DriveText" FontSize="28" FontWeight="SemiBold" />
                <TextBlock
                  Text="NTFS"
                  VerticalAlignment="Center"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                />
              </StackPanel>
            </StackPanel>
            <FontIcon
              x:Name="SelectedIcon"
              Grid.Column="2"
              Glyph="&#xE73E;"
              FontSize="16"
              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
              Visibility="Collapsed"
            />
          </Grid>
          <ProgressBar x:Name="UsageBar" Maximum="100" />
          <TextBlock x:Name="UsageText" FontSize="12" TextWrapping="Wrap" />
          <TextBlock
            x:Name="FreeText"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          />
          <TextBlock
            x:Name="CompactStateText"
            Text="未スキャン"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          />
        </StackPanel>
        <Border
          x:Name="ScanDetails"
          Grid.Column="1"
          BorderThickness="1,0,0,0"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          Padding="20,0,0,0"
          Visibility="Collapsed"
          Width="180"
          VerticalAlignment="Center"
        >
          <StackPanel Spacing="8">
            <TextBlock
              x:Name="ScanStateText"
              Margin="0,0,32,0"
              Text="未スキャン"
              FontWeight="SemiBold"
              TextTrimming="CharacterEllipsis"
              ToolTipService.ToolTip="{Binding Text, ElementName=ScanStateText}"
            />
            <ProgressBar x:Name="ScanProgressBar" Maximum="100" Visibility="Collapsed" />
            <TextBlock x:Name="FilesText" Text="ファイル数 —" FontSize="12" />
          </StackPanel>
        </Border>
      </Grid>
    </Button>
    <Button
      x:Name="ScanIconButton"
      Click="OnScanRequested"
      HorizontalAlignment="Right"
      VerticalAlignment="Top"
      Margin="12"
      Width="34"
      Height="34"
      Padding="6"
      ToolTipService.ToolTip="スキャン開始"
      AutomationProperties.Name="スキャン開始"
    >
      <FontIcon x:Name="ScanIcon" Glyph="&#xE72C;" FontSize="16" />
    </Button>
  </Grid>
</UserControl>
