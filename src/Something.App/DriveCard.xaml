<UserControl
  x:Class="Something.App.DriveCard"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Width="300"
  Height="140"
>
  <Grid>
    <Button
      x:Name="CardButton"
      Click="OnInvoked"
      HorizontalContentAlignment="Stretch"
      VerticalContentAlignment="Stretch"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      Padding="16"
      CornerRadius="10"
      BorderThickness="1"
      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
    >
      <Grid RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8" Margin="0,0,34,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xEDA2;" FontSize="18" />
          <TextBlock x:Name="DriveText" Grid.Column="1" FontSize="16" FontWeight="SemiBold" />
          <TextBlock
            x:Name="LabelText"
            Grid.Column="2"
            FontSize="13"
            VerticalAlignment="Center"
            TextTrimming="CharacterEllipsis"
          />
        </Grid>
        <ProgressBar x:Name="UsageBar" Grid.Row="2" Maximum="100" />
        <Grid Grid.Row="3" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="UsageText" FontSize="11" TextTrimming="CharacterEllipsis" />
          <TextBlock
            x:Name="FreeText"
            Grid.Column="1"
            FontSize="11"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          />
        </Grid>
        <Grid x:Name="ScanStatus" Grid.Row="4" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ProgressRing
            x:Name="ScanSpinner"
            Width="16"
            Height="16"
            MinWidth="0"
            MinHeight="0"
            IsActive="False"
            Visibility="Collapsed"
          />
          <TextBlock
            x:Name="ScanStateText"
            Grid.Column="1"
            Text="未スキャン"
            FontSize="12"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextTrimming="CharacterEllipsis"
          />
        </Grid>
      </Grid>
    </Button>
    <Border
      x:Name="SelectionOutline"
      BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
      BorderThickness="2"
      CornerRadius="10"
      Visibility="Collapsed"
      IsHitTestVisible="False"
    />
    <Button
      x:Name="ScanIconButton"
      Click="OnScanRequested"
      HorizontalAlignment="Right"
      VerticalAlignment="Top"
      Margin="10"
      Width="30"
      Height="30"
      Padding="6"
      ToolTipService.ToolTip="スキャン開始"
      AutomationProperties.Name="スキャン開始"
    >
      <FontIcon x:Name="ScanIcon" Glyph="&#xE72C;" FontSize="14" />
    </Button>
  </Grid>
</UserControl>
