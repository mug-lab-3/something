<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="Something.App.DateTimeRangeInput"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <Border
    CornerRadius="6"
    BorderThickness="1"
    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
    Background="{ThemeResource ControlFillColorDefaultBrush}"
    Padding="4"
  >
    <StackPanel Orientation="Horizontal" Spacing="4">
      <Button
        x:Uid="DateRange_StartButton"
        x:Name="StartButton"
        Background="Transparent"
        BorderThickness="0"
        Padding="12,8"
      >
        <StackPanel Orientation="Horizontal" Spacing="10">
          <FontIcon Glyph="&#xE787;" FontSize="16" />
          <TextBlock x:Name="StartText" Text="—" MinWidth="130" />
        </StackPanel>
        <Button.Flyout>
          <Flyout Placement="Bottom">
            <StackPanel Spacing="12">
              <CalendarDatePicker
                x:Uid="DateRange_StartDate"
                x:Name="StartDate"
                DateChanged="OnDateChanged"
                Width="220"
              />
              <TimePicker
                x:Uid="DateRange_StartTime"
                x:Name="StartTime"
                ClockIdentifier="24HourClock"
                TimeChanged="OnTimeChanged"
              />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
      <TextBlock
        Text="–"
        VerticalAlignment="Center"
        Margin="4,0"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
      />
      <Button
        x:Uid="DateRange_EndButton"
        x:Name="EndButton"
        Background="Transparent"
        BorderThickness="0"
        Padding="12,8"
      >
        <StackPanel Orientation="Horizontal" Spacing="10">
          <FontIcon Glyph="&#xE787;" FontSize="16" />
          <TextBlock x:Name="EndText" Text="—" MinWidth="130" />
        </StackPanel>
        <Button.Flyout>
          <Flyout Placement="Bottom">
            <StackPanel Spacing="12">
              <CalendarDatePicker
                x:Uid="DateRange_EndDate"
                x:Name="EndDate"
                DateChanged="OnDateChanged"
                Width="220"
              />
              <TimePicker
                x:Uid="DateRange_EndTime"
                x:Name="EndTime"
                ClockIdentifier="24HourClock"
                TimeChanged="OnTimeChanged"
              />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
      <Button
        x:Uid="DateRange_ClearButton"
        x:Name="ClearButton"
        Click="OnClear"
        Background="Transparent"
        BorderThickness="0"
        Padding="8"
        VerticalAlignment="Center"
      >
        <FontIcon Glyph="&#xE711;" FontSize="12" />
      </Button>
    </StackPanel>
  </Border>
</UserControl>
