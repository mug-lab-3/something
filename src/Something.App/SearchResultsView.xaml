<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="Something.App.SearchResultsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Something.App"
>
  <Grid RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Spacing="8">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button
          x:Uid="Search_BackToConditionsButton"
          x:Name="BackToConditionsButton"
          Click="OnBackToConditions"
        >
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE72B;" FontSize="14" />
            <TextBlock x:Uid="Search_BackToConditionsText" />
          </StackPanel>
        </Button>
        <Grid
          x:Name="ChipsHost"
          Grid.Column="1"
          SizeChanged="OnChipsHostSizeChanged"
          ColumnSpacing="6"
        >
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel
            x:Name="Chips"
            Orientation="Horizontal"
            Spacing="6"
            VerticalAlignment="Center"
          />
          <Button
            x:Name="MoreConditionsButton"
            x:Uid="Search_MoreConditionsButton"
            Grid.Column="1"
            Padding="10,4"
            Visibility="Collapsed"
          >
            <Button.Flyout>
              <Flyout Placement="Bottom">
                <StackPanel Spacing="6" MinWidth="240">
                  <TextBlock x:Uid="Search_AllConditionsTitle" FontWeight="SemiBold" />
                  <StackPanel x:Name="AllConditions" Spacing="4" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </Grid>
      </Grid>
      <TextBlock
        x:Name="CountsText"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        AutomationProperties.LiveSetting="Polite"
        TextWrapping="Wrap"
      />
    </StackPanel>
    <Grid x:Name="Body" Grid.Row="1" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border
        CornerRadius="8"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        Padding="8"
      >
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock x:Uid="Search_TreeHeader" FontWeight="SemiBold" Margin="8,6,8,12" />
          <TreeView
            x:Name="Folders"
            Grid.Row="1"
            SelectionMode="Single"
            Expanding="OnExpanding"
            ItemInvoked="OnFolderInvoked"
            ContextRequested="OnTreeContextRequested"
          >
            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
              <DataTemplate>
                <TextBlock
                  Text="{Binding Content.DisplayName}"
                  TextTrimming="CharacterEllipsis"
                  ToolTipService.ToolTip="{Binding Content.DisplayName}"
                />
              </DataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Grid>
      </Border>
      <Grid Grid.Column="1" RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12" Margin="12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <StackPanel.Resources>
              <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
              <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
              </Style>
            </StackPanel.Resources>
            <Button x:Uid="Main_BackButton" x:Name="BackButton" Click="OnBack" IsEnabled="False">
              <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <Button
              x:Uid="Main_ForwardButton"
              x:Name="ForwardButton"
              Click="OnForward"
              IsEnabled="False"
            >
              <FontIcon Glyph="&#xE72A;" FontSize="16" />
            </Button>
            <Button x:Uid="Main_UpButton" x:Name="UpButton" Click="OnUp" IsEnabled="False">
              <FontIcon Glyph="&#xE74A;" FontSize="16" />
            </Button>
          </StackPanel>
          <TextBlock
            x:Name="PathText"
            Grid.Column="1"
            VerticalAlignment="Center"
            TextTrimming="CharacterEllipsis"
            ToolTipService.ToolTip="{Binding Text, ElementName=PathText}"
          />
        </Grid>
        <Grid Grid.Row="1" Padding="12" RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource ListHeaderBandStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="152" />
                <ColumnDefinition Width="152" />
                <ColumnDefinition Width="102" />
              </Grid.ColumnDefinitions>
              <Button
                x:Name="NameHeader"
                Padding="60,6,6,6"
                Tag="Name"
                Click="OnSort"
                Style="{StaticResource ColumnHeaderButtonStyle}"
              />
              <Button
                x:Name="SizeHeader"
                Grid.Column="1"
                Padding="6"
                HorizontalContentAlignment="Right"
                Tag="Size"
                Click="OnSort"
                Style="{StaticResource ColumnHeaderButtonStyle}"
              />
              <Button
                x:Name="DeltaHeader"
                Grid.Column="2"
                Padding="6"
                HorizontalContentAlignment="Right"
                Tag="Delta"
                Click="OnSort"
                Style="{StaticResource ColumnHeaderButtonStyle}"
              />
            </Grid>
          </Border>
          <ListView
            x:Name="Entries"
            Grid.Row="1"
            ItemContainerStyle="{StaticResource ListRowContainerStyle}"
            SelectionMode="Single"
            DoubleTapped="OnEntryInvoked"
            ContextRequested="OnEntryContextRequested"
            ContainerContentChanging="OnContainerContentChanging"
          >
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="local:SearchRow">
                <Grid ColumnSpacing="12" Padding="0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="36" />
                  </Grid.ColumnDefinitions>
                  <local:FileAttributeIcon
                    IsDirectory="{x:Bind IsDirectory}"
                    IsHidden="{x:Bind IsHidden}"
                    IsSystem="{x:Bind IsSystem}"
                    AttributesKnown="{x:Bind AttributesKnown}"
                    VerticalAlignment="Center"
                  />
                  <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Name}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Path}"
                  />
                  <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Text="{x:Bind Size}"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="{x:Bind SizeDescription}"
                  />
                  <TextBlock
                    Grid.Column="3"
                    HorizontalAlignment="Right"
                    Text="{x:Bind Delta}"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="{x:Bind SizeDescription}"
                  />
                  <Button
                    x:Uid="Search_GraphButton"
                    Grid.Column="4"
                    Width="32"
                    Height="32"
                    Padding="6"
                    BorderThickness="0"
                    Background="Transparent"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="OnGraphEntry"
                  >
                    <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                  </Button>
                  <Button
                    x:Uid="Main_RecycleButton"
                    Grid.Column="5"
                    Width="32"
                    Height="32"
                    Padding="6"
                    BorderThickness="0"
                    Background="Transparent"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    IsEnabled="{x:Bind Removal.CanRecycle, Mode=OneWay}"
                    Visibility="{x:Bind RecycleVisibility}"
                    Click="OnRecycleEntry"
                  >
                    <FontIcon Glyph="&#xE74D;" FontSize="16" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock
            x:Name="EmptyText"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            IsHitTestVisible="False"
            Visibility="Collapsed"
          />
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
