<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.3.0</Version>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <DefaultLanguage>ja-JP</DefaultLanguage>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Something.ico</ApplicationIcon>
    <EnableDefaultAssets>false</EnableDefaultAssets>
  </PropertyGroup>
  <ItemGroup>
    <Content
      Update="Assets/app-icon.png"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <Content
      Include="Assets/Something.ico"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <!-- Install the project license and third-party notices next to the application. -->
    <Content
      Include="../../LICENSE;../../THIRD-PARTY-NOTICES.md"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7175" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.20250829.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="1.8.25122902" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WinUI" Version="2.0.5" />
    <ProjectReference Include="../Something.Application/Something.Application.csproj" />
    <!-- Only the startup composition picks the storage implementation. -->
    <ProjectReference Include="../Something.Storage/Something.Storage.csproj" />
  </ItemGroup>
  <!-- LiveCharts2 depends on the Windows App SDK metapackage. Unpinned, NuGet picks an older
       monolithic version whose WinUI conflicts with the split packages above, so pin the
       metapackage whose dependencies match them exactly. Its AI, ML, Widgets and Runtime
       packages (and ML's System.Numerics.Tensors) are unused and would ship about 45 MiB
       (onnxruntime, DirectML), so exclude their assets. Keep all versions in step when
       updating the Windows App SDK. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="1.8.79" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="1.8.2197" ExcludeAssets="all" />
    <PackageReference
      Include="Microsoft.WindowsAppSDK.Widgets"
      Version="1.8.251231004"
      ExcludeAssets="all"
    />
    <PackageReference
      Include="Microsoft.WindowsAppSDK.Runtime"
      Version="1.8.260804001"
      ExcludeAssets="all"
    />
    <PackageReference Include="System.Numerics.Tensors" Version="9.0.0" ExcludeAssets="all" />
  </ItemGroup>
</Project>
