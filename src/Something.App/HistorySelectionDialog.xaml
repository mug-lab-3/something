<ContentDialog
  x:Uid="HistorySelectionDialog"
  x:Class="Something.App.HistorySelectionDialog"
  Style="{StaticResource DefaultContentDialogStyle}"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Something.App"
  DefaultButton="None"
  Opened="OnOpened"
  Closed="OnClosed"
>
  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">1000</x:Double>
    <Style
      x:Key="CompactDialogButtonStyle"
      TargetType="Button"
      BasedOn="{StaticResource DefaultButtonStyle}"
    >
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="16,4" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
  </ContentDialog.Resources>
  <ContentDialog.PrimaryButtonStyle>
    <Style TargetType="Button" BasedOn="{StaticResource CompactDialogButtonStyle}" />
  </ContentDialog.PrimaryButtonStyle>
  <ContentDialog.CloseButtonStyle>
    <Style TargetType="Button" BasedOn="{StaticResource CompactDialogButtonStyle}" />
  </ContentDialog.CloseButtonStyle>
  <Grid x:Name="DialogContent" Width="860" Height="500" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock
      x:Name="ContextText"
      TextWrapping="Wrap"
      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
    />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <ToggleButton
        x:Uid="HistorySelection_AllButton"
        x:Name="AllButton"
        Tag="All"
        Click="OnPeriod"
        IsChecked="True"
      />
      <ToggleButton
        x:Uid="HistorySelection_WeekButton"
        x:Name="WeekButton"
        Tag="Week"
        Click="OnPeriod"
      />
      <ToggleButton
        x:Uid="HistorySelection_MonthButton"
        x:Name="MonthButton"
        Tag="Month"
        Click="OnPeriod"
      />
      <ToggleButton
        x:Uid="HistorySelection_YearButton"
        x:Name="YearButton"
        Tag="Year"
        Click="OnPeriod"
      />
    </StackPanel>
    <Grid Grid.Row="2" ColumnSpacing="24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="12">
        <TextBlock x:Uid="HistorySelection_FilterHeader" FontWeight="SemiBold" />
        <Border x:Name="CalendarHost" />
        <TextBlock
          x:Uid="HistorySelection_CalendarLegend"
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        />
      </StackPanel>
      <Grid Grid.Column="1" RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="RangeText" FontWeight="SemiBold" />
        <Border
          x:Name="SelectionHeaderBand"
          Grid.Row="1"
          Style="{StaticResource ListHeaderBandStyle}"
        >
          <Grid Padding="{StaticResource ListContentPadding}">
            <TextBlock
              x:Uid="HistorySelection_CompletedHeader"
              Style="{StaticResource ListHeaderTextStyle}"
            />
            <TextBlock
              x:Uid="HistorySelection_CountHeader"
              HorizontalAlignment="Right"
              Style="{StaticResource ListHeaderTextStyle}"
            />
          </Grid>
        </Border>
        <ListView
          x:Name="Records"
          ItemContainerStyle="{StaticResource ListRowContainerStyle}"
          Grid.Row="2"
          SelectionMode="Single"
          HorizontalContentAlignment="Stretch"
          SelectionChanged="OnSelectionChanged"
          ContainerContentChanging="OnContainerChanging"
        >
          <ListView.ItemsPanel>
            <ItemsPanelTemplate>
              <ItemsStackPanel AreStickyGroupHeadersEnabled="True" />
            </ItemsPanelTemplate>
          </ListView.ItemsPanel>
          <ListView.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate x:DataType="local:HistoryPickerGroup">
                  <Border
                    Padding="12,12,12,6"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                  >
                    <TextBlock
                      Text="{x:Bind Label}"
                      FontWeight="SemiBold"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    />
                  </Border>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListView.GroupStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:HistoryPickerRow">
              <Grid Padding="0,10" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind TimeText}" />
                <TextBlock
                  Grid.Column="1"
                  Text="{x:Bind CountText, Mode=OneWay}"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <TextBlock
          x:Uid="HistorySelection_EmptyText"
          x:Name="EmptyText"
          Grid.Row="2"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        />
        <TextBlock
          x:Uid="HistorySelection_CountError"
          x:Name="CountError"
          Grid.Row="3"
          Visibility="Collapsed"
          TextWrapping="Wrap"
          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
        />
      </Grid>
    </Grid>
  </Grid>
</ContentDialog>
