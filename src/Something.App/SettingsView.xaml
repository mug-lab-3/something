<UserControl
  x:Class="Something.App.SettingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <UserControl.Resources>
    <Style x:Key="SettingItemStyle" TargetType="StackPanel">
      <Setter Property="Spacing" Value="6" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style
      x:Key="SubsectionHeaderStyle"
      TargetType="TextBlock"
      BasedOn="{StaticResource BodyStrongTextBlockStyle}"
    >
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
  </UserControl.Resources>
  <Grid RowSpacing="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button
        x:Uid="Settings_BackButton"
        x:Name="BackButton"
        Background="Transparent"
        BorderThickness="0"
        VerticalAlignment="Center"
        Click="OnBack"
      >
        <Button.KeyboardAccelerators>
          <KeyboardAccelerator Key="Escape" />
        </Button.KeyboardAccelerators>
        <FontIcon Glyph="&#xE72B;" FontSize="16" />
      </Button>
      <TextBlock
        x:Uid="Settings_Title"
        Grid.Column="1"
        Style="{StaticResource SubtitleTextBlockStyle}"
        VerticalAlignment="Center"
      />
      <AutoSuggestBox
        x:Uid="Settings_SearchBox"
        x:Name="SearchBox"
        Grid.Column="3"
        Width="360"
        QueryIcon="Find"
        VerticalAlignment="Center"
        TextChanged="OnSearchChanged"
      />
    </Grid>
    <Grid Grid.Row="1" ColumnSpacing="24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TreeView
        x:Uid="Settings_SectionTree"
        x:Name="SectionTree"
        SelectionMode="Single"
        ItemInvoked="OnSectionInvoked"
      />
      <ScrollViewer
        x:Name="ItemScroll"
        Grid.Column="1"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        ViewChanged="OnItemsScrolled"
      >
        <!-- Items keep one width while search hides some of them; the column caps line length. -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="760" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="ItemPanel" Spacing="8" Padding="0,0,16,24">
            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" />
            <TextBlock
              x:Name="NoResultsText"
              Visibility="Collapsed"
              TextWrapping="Wrap"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            />

            <TextBlock
              x:Uid="Settings_DisplayHeader"
              x:Name="DisplayHeader"
              Style="{StaticResource SubtitleTextBlockStyle}"
            />
            <TextBlock
              x:Uid="Settings_AppearanceHeader"
              x:Name="AppearanceHeader"
              Style="{StaticResource SubsectionHeaderStyle}"
            />
            <StackPanel x:Name="ThemeItem" Style="{StaticResource SettingItemStyle}">
              <TextBlock x:Uid="Settings_ThemeTitle" Style="{StaticResource SettingTitleStyle}" />
              <ComboBox
                x:Uid="Settings_ThemeBox"
                x:Name="ThemeBox"
                MinWidth="240"
                SelectionChanged="OnThemeChanged"
              >
                <ComboBoxItem x:Uid="Settings_ThemeSystem" />
                <ComboBoxItem x:Uid="Settings_ThemeDark" />
                <ComboBoxItem x:Uid="Settings_ThemeLight" />
              </ComboBox>
            </StackPanel>
            <StackPanel x:Name="LanguageItem" Style="{StaticResource SettingItemStyle}">
              <TextBlock
                x:Uid="Settings_LanguageTitle"
                Style="{StaticResource SettingTitleStyle}"
              />
              <ComboBox
                x:Uid="Settings_LanguageBox"
                x:Name="LanguageBox"
                MinWidth="240"
                SelectionChanged="OnLanguageChanged"
              >
                <ComboBoxItem x:Uid="Settings_LanguageSystem" />
                <ComboBoxItem x:Uid="Settings_LanguageJapanese" />
                <ComboBoxItem x:Uid="Settings_LanguageEnglish" />
              </ComboBox>
              <InfoBar
                x:Uid="Settings_LanguageRestartBar"
                x:Name="LanguageRestartBar"
                Severity="Informational"
                IsOpen="False"
                IsClosable="False"
              >
                <InfoBar.ActionButton>
                  <Button x:Uid="Settings_RestartButton" x:Name="RestartButton" Click="OnRestart" />
                </InfoBar.ActionButton>
              </InfoBar>
            </StackPanel>
            <TextBlock
              x:Uid="Settings_FilesHeader"
              x:Name="FilesHeader"
              Style="{StaticResource SubsectionHeaderStyle}"
            />
            <StackPanel x:Name="IncludeSystemItem" Style="{StaticResource SettingItemStyle}">
              <TextBlock
                x:Uid="Settings_IncludeSystemTitle"
                Style="{StaticResource SettingTitleStyle}"
              />
              <CheckBox
                x:Uid="Settings_IncludeSystem"
                x:Name="IncludeSystem"
                Checked="OnVisibilityChanged"
                Unchecked="OnVisibilityChanged"
              />
            </StackPanel>
            <StackPanel x:Name="IncludeHiddenItem" Style="{StaticResource SettingItemStyle}">
              <TextBlock
                x:Uid="Settings_IncludeHiddenTitle"
                Style="{StaticResource SettingTitleStyle}"
              />
              <CheckBox
                x:Uid="Settings_IncludeHidden"
                x:Name="IncludeHidden"
                Checked="OnVisibilityChanged"
                Unchecked="OnVisibilityChanged"
              />
            </StackPanel>

            <TextBlock
              x:Uid="Settings_TreeHeader"
              x:Name="TreeHeader"
              Style="{StaticResource SubsectionHeaderStyle}"
            />
            <StackPanel x:Name="FollowListItem" Style="{StaticResource SettingItemStyle}">
              <TextBlock
                x:Uid="Settings_FollowListTitle"
                Style="{StaticResource SettingTitleStyle}"
              />
              <CheckBox
                x:Uid="Settings_FollowList"
                x:Name="FollowListInTree"
                Checked="OnFollowListChanged"
                Unchecked="OnFollowListChanged"
              />
            </StackPanel>

            <TextBlock
              x:Uid="Settings_DatabaseHeader"
              x:Name="DatabaseHeader"
              Margin="0,16,0,0"
              Style="{StaticResource SubtitleTextBlockStyle}"
            />
            <TextBlock
              x:Uid="Settings_BusyHint"
              x:Name="BusyHint"
              Visibility="Collapsed"
              Style="{StaticResource SettingDescriptionStyle}"
            />
            <TextBlock
              x:Uid="Settings_LocationHeader"
              x:Name="LocationHeader"
              Style="{StaticResource SubsectionHeaderStyle}"
            />
            <StackPanel x:Name="CurrentDatabaseItem" Style="{StaticResource SettingItemStyle}">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  x:Uid="Settings_CurrentTitle"
                  Style="{StaticResource SettingTitleStyle}"
                />
                <TextBlock x:Name="SizeText" Grid.Column="1" FontSize="20" FontWeight="SemiBold" />
              </Grid>
              <TextBlock
                x:Name="CurrentPathText"
                IsTextSelectionEnabled="True"
                Style="{StaticResource SettingDescriptionStyle}"
              />
            </StackPanel>
            <StackPanel x:Name="LocationItem" Style="{StaticResource SettingItemStyle}">
              <TextBlock
                x:Uid="Settings_LocationTitle"
                Style="{StaticResource SettingTitleStyle}"
              />
              <TextBlock
                x:Uid="Settings_MoveHint"
                Style="{StaticResource SettingDescriptionStyle}"
              />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                  x:Uid="Settings_DirectoryBox"
                  x:Name="DirectoryBox"
                  TextChanged="OnDirectoryChanged"
                />
                <Button
                  x:Uid="Settings_BrowseButton"
                  x:Name="BrowseButton"
                  Grid.Column="1"
                  Click="OnBrowse"
                />
                <Button
                  x:Uid="Settings_MoveButton"
                  x:Name="MoveButton"
                  Grid.Column="2"
                  Style="{StaticResource AccentButtonStyle}"
                  Click="OnMove"
                />
              </Grid>
            </StackPanel>
            <TextBlock
              x:Uid="Settings_ManagementHeader"
              x:Name="ManagementHeader"
              Style="{StaticResource SubsectionHeaderStyle}"
            />
            <StackPanel x:Name="OpenFolderItem" Style="{StaticResource SettingItemStyle}">
              <TextBlock
                x:Uid="Settings_OpenFolderTitle"
                Style="{StaticResource SettingTitleStyle}"
              />
              <TextBlock
                x:Uid="Settings_OpenFolderDescription"
                Style="{StaticResource SettingDescriptionStyle}"
              />
              <Button x:Name="OpenFolderButton" HorizontalAlignment="Left" Click="OnOpenFolder">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xED25;" FontSize="16" />
                  <TextBlock x:Uid="Settings_OpenFolderText" />
                </StackPanel>
              </Button>
            </StackPanel>
            <StackPanel x:Name="DeleteDatabaseItem" Style="{StaticResource SettingItemStyle}">
              <TextBlock x:Uid="Settings_DeleteTitle" Style="{StaticResource SettingTitleStyle}" />
              <TextBlock
                x:Uid="Settings_DeleteDescription"
                Style="{StaticResource SettingDescriptionStyle}"
              />
              <Button
                x:Name="DeleteDatabaseButton"
                HorizontalAlignment="Left"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Click="OnDeleteDatabase"
              >
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE74D;" FontSize="16" />
                  <TextBlock x:Uid="Settings_DeleteDatabaseText" />
                </StackPanel>
              </Button>
            </StackPanel>

            <TextBlock
              x:Uid="Settings_ApplicationHeader"
              x:Name="ApplicationHeader"
              Margin="0,16,0,0"
              Style="{StaticResource SubtitleTextBlockStyle}"
            />
            <TextBlock
              x:Uid="Settings_UpdatesHeader"
              x:Name="UpdatesHeader"
              Style="{StaticResource SubsectionHeaderStyle}"
            />
            <StackPanel x:Name="UpdateCheckItem" Style="{StaticResource SettingItemStyle}">
              <TextBlock
                x:Uid="Settings_UpdateCheckTitle"
                Style="{StaticResource SettingTitleStyle}"
              />
              <TextBlock
                x:Uid="Settings_UpdateCheckDescription"
                Style="{StaticResource SettingDescriptionStyle}"
              />
              <CheckBox
                x:Uid="Settings_UpdateCheck"
                x:Name="CheckForUpdates"
                Checked="OnCheckForUpdatesChanged"
                Unchecked="OnCheckForUpdatesChanged"
              />
              <TextBlock
                x:Name="CurrentVersionText"
                Style="{StaticResource SettingDescriptionStyle}"
              />
            </StackPanel>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
