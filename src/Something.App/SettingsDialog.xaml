<ContentDialog
  x:Class="Something.App.SettingsDialog"
  Style="{StaticResource DefaultContentDialogStyle}"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="設定"
  PrimaryButtonText="保存"
  CloseButtonText="キャンセル"
  DefaultButton="None"
  PrimaryButtonStyle="{StaticResource ConfirmationDialogButtonStyle}"
  CloseButtonStyle="{StaticResource SecondaryDialogButtonStyle}"
  PrimaryButtonClick="OnSave"
>
  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
  </ContentDialog.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Width="560" Spacing="20">
      <StackPanel Spacing="8">
        <TextBlock Text="表示" Style="{StaticResource SubtitleTextBlockStyle}" />
        <CheckBox x:Name="IncludeSystem" Content="システムフォルダ・ファイルを含める" />
        <CheckBox x:Name="IncludeHidden" Content="隠しフォルダ・ファイルを含める" />
      </StackPanel>
      <StackPanel x:Name="DatabaseSection" Spacing="12">
        <TextBlock Text="DB設定" Style="{StaticResource SubtitleTextBlockStyle}" />
        <Border
          Padding="16"
          CornerRadius="8"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
        >
          <StackPanel Spacing="8">
            <Grid>
              <TextBlock Text="現在のDBサイズ" VerticalAlignment="Center" />
              <TextBlock
                x:Name="SizeText"
                FontSize="20"
                FontWeight="SemiBold"
                HorizontalAlignment="Right"
              />
            </Grid>
            <TextBlock
              x:Name="CurrentPathText"
              TextWrapping="Wrap"
              IsTextSelectionEnabled="True"
              FontSize="12"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            />
          </StackPanel>
        </Border>
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox
            x:Name="DirectoryBox"
            Header="DBの保存フォルダ"
            PlaceholderText="保存先の絶対パス"
          />
          <Button
            x:Name="BrowseButton"
            Grid.Column="1"
            Content="参照…"
            VerticalAlignment="Bottom"
            Click="OnBrowse"
          />
        </Grid>
        <TextBlock
          Text="保存先を変更すると、現在の履歴DBを移動します。移動先のDBは上書きしません。"
          TextWrapping="Wrap"
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Background="Transparent" BorderThickness="0" Click="OnOpenFolder">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xED25;" FontSize="16" />
              <TextBlock Text="DBフォルダを開く" />
            </StackPanel>
          </Button>
          <Button
            x:Name="DeleteDatabaseButton"
            Background="Transparent"
            BorderThickness="0"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Click="OnDeleteDatabase"
          >
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE74D;" FontSize="16" />
              <TextBlock Text="DBを削除" />
            </StackPanel>
          </Button>
        </StackPanel>
        <TextBlock
          x:Name="BusyHint"
          Text="スキャンや処理が完了すると、保存先の変更とDB削除ができます。"
          Visibility="Collapsed"
          TextWrapping="Wrap"
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        />
      </StackPanel>
      <TextBlock
        x:Name="ErrorText"
        Visibility="Collapsed"
        TextWrapping="Wrap"
        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
      />
    </StackPanel>
  </ScrollViewer>
</ContentDialog>
