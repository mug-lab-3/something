<ContentDialog
  x:Uid="SettingsDialog"
  x:Class="Something.App.SettingsDialog"
  Style="{StaticResource DefaultContentDialogStyle}"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  DefaultButton="None"
  PrimaryButtonStyle="{StaticResource ConfirmationDialogButtonStyle}"
  CloseButtonStyle="{StaticResource SecondaryDialogButtonStyle}"
  PrimaryButtonClick="OnSave"
>
  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
  </ContentDialog.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Width="560" Spacing="20">
      <StackPanel Spacing="8">
        <TextBlock x:Uid="Settings_DisplayHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
        <CheckBox x:Uid="Settings_IncludeSystem" x:Name="IncludeSystem" />
        <CheckBox x:Uid="Settings_IncludeHidden" x:Name="IncludeHidden" />
      </StackPanel>
      <StackPanel x:Name="DatabaseSection" Spacing="12">
        <TextBlock
          x:Uid="Settings_DatabaseHeader"
          Style="{StaticResource SubtitleTextBlockStyle}"
        />
        <Border
          Padding="16"
          CornerRadius="8"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
        >
          <StackPanel Spacing="8">
            <Grid>
              <TextBlock x:Uid="Settings_SizeLabel" VerticalAlignment="Center" />
              <TextBlock
                x:Name="SizeText"
                FontSize="20"
                FontWeight="SemiBold"
                HorizontalAlignment="Right"
              />
            </Grid>
            <TextBlock
              x:Name="CurrentPathText"
              TextWrapping="Wrap"
              IsTextSelectionEnabled="True"
              FontSize="12"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            />
          </StackPanel>
        </Border>
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Uid="Settings_DirectoryBox" x:Name="DirectoryBox" />
          <Button
            x:Uid="Settings_BrowseButton"
            x:Name="BrowseButton"
            Grid.Column="1"
            VerticalAlignment="Bottom"
            Click="OnBrowse"
          />
        </Grid>
        <TextBlock
          x:Uid="Settings_MoveHint"
          TextWrapping="Wrap"
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Background="Transparent" BorderThickness="0" Click="OnOpenFolder">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xED25;" FontSize="16" />
              <TextBlock x:Uid="Settings_OpenFolderText" />
            </StackPanel>
          </Button>
          <Button
            x:Name="DeleteDatabaseButton"
            Background="Transparent"
            BorderThickness="0"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Click="OnDeleteDatabase"
          >
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE74D;" FontSize="16" />
              <TextBlock x:Uid="Settings_DeleteDatabaseText" />
            </StackPanel>
          </Button>
        </StackPanel>
        <TextBlock
          x:Uid="Settings_BusyHint"
          x:Name="BusyHint"
          Visibility="Collapsed"
          TextWrapping="Wrap"
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        />
      </StackPanel>
      <TextBlock
        x:Name="ErrorText"
        Visibility="Collapsed"
        TextWrapping="Wrap"
        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
      />
    </StackPanel>
  </ScrollViewer>
</ContentDialog>
