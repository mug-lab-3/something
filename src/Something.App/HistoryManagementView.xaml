<UserControl
  x:Class="Something.App.HistoryManagementView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Something.App"
>
  <Grid RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border
      CornerRadius="8"
      Padding="16"
      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
      BorderThickness="1"
    >
      <StackPanel x:Name="SelectionControls" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="開始日時（指定なしなら最初から）" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <CalendarDatePicker
                x:Name="FromDate"
                DateChanged="OnDateChanged"
                Width="155"
                PlaceholderText="指定なし"
              />
              <TimePicker
                x:Name="FromTime"
                ClockIdentifier="24HourClock"
                TimeChanged="OnTimeChanged"
              />
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="終了日時（指定なしなら最新まで）" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <CalendarDatePicker
                x:Name="EndDate"
                DateChanged="OnDateChanged"
                Width="155"
                PlaceholderText="指定なし"
              />
              <TimePicker
                x:Name="EndTime"
                ClockIdentifier="24HourClock"
                TimeChanged="OnTimeChanged"
              />
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox
            x:Name="PresetBox"
            Width="190"
            PlaceholderText="簡易プリセット"
            SelectionChanged="OnPresetChanged"
          >
            <ComboBoxItem Content="1か月前以前" Tag="1" />
            <ComboBoxItem Content="3か月前以前" Tag="3" />
            <ComboBoxItem Content="半年前以前" Tag="6" />
            <ComboBoxItem Content="1年前以前" Tag="12" />
          </ComboBox>
          <Button
            x:Name="SelectAllButton"
            Grid.Column="1"
            Content="すべて選択"
            Click="OnSelectAll"
          />
          <Button
            x:Name="ClearSelectionButton"
            Grid.Column="2"
            Content="選択解除"
            Click="OnClearSelection"
          />
          <TextBlock
            x:Name="SelectionCountText"
            Grid.Column="3"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            Text="選択中 0件"
            FontWeight="SemiBold"
            AutomationProperties.LiveSetting="Polite"
          />
          <Button
            x:Name="DeleteButton"
            Grid.Column="4"
            Click="OnDelete"
            IsEnabled="False"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
          >
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE74D;" FontSize="16" />
              <TextBlock Text="履歴を削除" />
            </StackPanel>
          </Button>
        </Grid>
        <TextBlock
          Text="日時範囲やプリセットでチェックを付け、一覧で個別に調整できます。境界を含み、入力時刻の秒は00として扱います。"
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          TextWrapping="Wrap"
        />
        <TextBlock
          x:Name="SelectionError"
          Visibility="Collapsed"
          TextWrapping="Wrap"
          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
        />
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="1" Spacing="8">
      <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" />
      <StackPanel
        x:Name="ConfirmationPanel"
        Orientation="Horizontal"
        Spacing="12"
        Visibility="Collapsed"
      >
        <TextBlock x:Name="ConfirmationText" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button
          x:Name="ConfirmDeleteButton"
          Content="削除を確定"
          Click="OnConfirmDelete"
          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
        />
        <Button x:Name="CancelDeleteButton" Content="キャンセル" Click="OnCancelDelete" />
      </StackPanel>
    </StackPanel>
    <Border
      Grid.Row="2"
      CornerRadius="8"
      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
      BorderThickness="1"
      Padding="12"
    >
      <Grid RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="スキャン履歴" FontSize="20" FontWeight="SemiBold" />
            <TextBlock
              x:Name="TotalText"
              VerticalAlignment="Center"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Text="0件"
            />
          </StackPanel>
          <ProgressRing
            x:Name="BusyRing"
            Grid.Column="1"
            Width="20"
            Height="20"
            IsActive="False"
            Visibility="Collapsed"
          />
          <Button
            x:Name="RefreshButton"
            Grid.Column="2"
            Click="OnRefresh"
            ToolTipService.ToolTip="履歴を更新"
            AutomationProperties.Name="履歴を更新"
          >
            <FontIcon Glyph="&#xE72C;" FontSize="16" />
          </Button>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12" Padding="44,0,12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="120" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="スキャン完了日時" FontWeight="SemiBold" />
          <TextBlock Grid.Column="1" Text="ドライブ" FontWeight="SemiBold" />
          <TextBlock Grid.Column="2" Text="処理時間" FontWeight="SemiBold" />
        </Grid>
        <ListView
          x:Name="HistoryList"
          Grid.Row="2"
          SelectionMode="Multiple"
          SelectionChanged="OnSelectionChanged"
          HorizontalContentAlignment="Stretch"
        >
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:ManagedHistoryRow">
              <Grid ColumnSpacing="12" Padding="0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind CompletedText}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Entry.Drive}" />
                <TextBlock Grid.Column="2" Text="{x:Bind ElapsedText}" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <TextBlock
          x:Name="EmptyText"
          Grid.Row="2"
          Text="このドライブには保存された履歴がありません。"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        />
      </Grid>
    </Border>
    <TextBlock
      Grid.Row="3"
      Text="スキャン履歴のみを削除します。実ファイルには影響しません。DBの空き領域は再利用されるため、ファイル容量がすぐ縮むとは限りません。"
      FontSize="12"
      TextWrapping="Wrap"
      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
    />
  </Grid>
</UserControl>
