<UserControl
  x:Class="Something.App.HistoryManagementView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Something.App"
>
  <UserControl.Resources>
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
    <Style
      x:Key="GhostButtonStyle"
      TargetType="Button"
      BasedOn="{StaticResource DefaultButtonStyle}"
    >
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
  </UserControl.Resources>
  <Grid RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border
      Padding="0,0,0,16"
      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
      BorderThickness="0,0,0,1"
    >
      <StackPanel x:Name="SelectionControls" Spacing="12">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border
            CornerRadius="6"
            BorderThickness="1"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            Padding="4"
          >
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button
                x:Name="FromRangeButton"
                Background="Transparent"
                BorderThickness="0"
                Padding="12,8"
                AutomationProperties.Name="範囲の開始日時"
                ToolTipService.ToolTip="範囲の開始日時を編集"
              >
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <FontIcon Glyph="&#xE787;" FontSize="16" />
                  <TextBlock x:Name="FromValueText" Text="最初の記録" MinWidth="160" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="Bottom">
                    <StackPanel Spacing="12">
                      <CalendarDatePicker
                        x:Name="FromDate"
                        DateChanged="OnDateChanged"
                        Width="220"
                        PlaceholderText="最初の記録"
                        AutomationProperties.Name="開始日"
                      />
                      <TimePicker
                        x:Name="FromTime"
                        ClockIdentifier="24HourClock"
                        TimeChanged="OnTimeChanged"
                        AutomationProperties.Name="開始時刻"
                      />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <TextBlock
                Text="–"
                VerticalAlignment="Center"
                Margin="4,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              />
              <Button
                x:Name="EndRangeButton"
                Background="Transparent"
                BorderThickness="0"
                Padding="12,8"
                AutomationProperties.Name="範囲の終了日時"
                ToolTipService.ToolTip="範囲の終了日時を編集"
              >
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock x:Name="EndValueText" Text="最新の記録" MinWidth="160" />
                  <FontIcon Glyph="&#xE787;" FontSize="16" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="Bottom">
                    <StackPanel Spacing="12">
                      <CalendarDatePicker
                        x:Name="EndDate"
                        DateChanged="OnDateChanged"
                        Width="220"
                        PlaceholderText="最新の記録"
                        AutomationProperties.Name="終了日"
                      />
                      <TimePicker
                        x:Name="EndTime"
                        ClockIdentifier="24HourClock"
                        TimeChanged="OnTimeChanged"
                        AutomationProperties.Name="終了時刻"
                      />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button
                x:Name="ClearRangeButton"
                Click="OnClearRange"
                Background="Transparent"
                BorderThickness="0"
                Padding="8"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="範囲の入力をクリア"
                AutomationProperties.Name="範囲の入力をクリア"
              >
                <FontIcon Glyph="&#xE711;" FontSize="12" />
              </Button>
            </StackPanel>
          </Border>
          <Button
            x:Name="ApplyRangeButton"
            Grid.Column="1"
            Style="{StaticResource GhostButtonStyle}"
            ToolTipService.ToolTip="この範囲で選択"
            AutomationProperties.Name="この範囲で選択"
            Width="36"
            Height="36"
            MinWidth="0"
            Padding="0"
            Click="OnApplyRange"
            VerticalAlignment="Center"
          >
            <FontIcon Glyph="&#xE73E;" FontSize="18" />
          </Button>
          <Button
            x:Name="OptimizeButton"
            Style="{StaticResource GhostButtonStyle}"
            Grid.Column="4"
            Click="OnOptimize"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            ToolTipService.ToolTip="全ドライブ共通の履歴DBを詰め直します。"
          >
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE90F;" FontSize="16" />
              <TextBlock Text="DBを最適化" />
            </StackPanel>
          </Button>
        </Grid>
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
              x:Name="MonthPresetButton"
              Style="{StaticResource GhostButtonStyle}"
              Content="1か月前以前"
              Tag="1"
              Click="OnPresetClick"
            />
            <Button
              x:Name="ThreeMonthsPresetButton"
              Style="{StaticResource GhostButtonStyle}"
              Content="3か月前以前"
              Tag="3"
              Click="OnPresetClick"
            />
            <Button
              x:Name="HalfYearPresetButton"
              Style="{StaticResource GhostButtonStyle}"
              Content="半年前以前"
              Tag="6"
              Click="OnPresetClick"
            />
            <Button
              x:Name="YearPresetButton"
              Style="{StaticResource GhostButtonStyle}"
              Content="1年前以前"
              Tag="12"
              Click="OnPresetClick"
            />
          </StackPanel>
        </Grid>

        <TextBlock
          x:Name="SelectionError"
          Visibility="Collapsed"
          TextWrapping="Wrap"
          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
        />
      </StackPanel>
    </Border>
    <Border Grid.Row="2">
      <Grid RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="スキャン履歴" FontSize="20" FontWeight="SemiBold" />
            <TextBlock
              x:Name="TotalText"
              VerticalAlignment="Center"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Text="0件"
            />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
            <TextBlock
              x:Name="SelectionCountText"
              VerticalAlignment="Center"
              Text="選択中 0件"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              AutomationProperties.LiveSetting="Polite"
            />
            <Button
              x:Name="DeleteButton"
              Style="{StaticResource GhostButtonStyle}"
              Click="OnDelete"
              IsEnabled="False"
              Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            >
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE74D;" FontSize="16" />
                <TextBlock Text="履歴を削除" />
              </StackPanel>
            </Button>
            <ProgressRing
              x:Name="BusyRing"
              Grid.Column="1"
              Width="20"
              Height="20"
              IsActive="False"
              Visibility="Collapsed"
            />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12" Padding="12,0,12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="160" />
          </Grid.ColumnDefinitions>
          <CheckBox
            x:Name="SelectAllCheckBox"
            MinWidth="0"
            Width="20"
            MinHeight="0"
            IsEnabled="False"
            IsThreeState="False"
            Click="OnToggleAll"
            ToolTipService.ToolTip="すべて選択"
            AutomationProperties.Name="すべて選択"
          />
          <Button
            x:Name="CompletedHeader"
            Grid.Column="1"
            Content="スキャン完了日時 ▼"
            Tag="Completed"
            Click="OnHistorySort"
            Style="{StaticResource ColumnHeaderButtonStyle}"
          />
          <Button
            x:Name="RecordCountHeader"
            Grid.Column="2"
            Content="記録数"
            Tag="Count"
            Click="OnHistorySort"
            Style="{StaticResource ColumnHeaderButtonStyle}"
            HorizontalAlignment="Right"
            ToolTipService.ToolTip="保存したMFT観測レコード数。未解決・拡張レコードを含み、内部テーブルの行数合計ではありません。"
          />
        </Grid>
        <ListView
          x:Name="HistoryList"
          Grid.Row="2"
          SelectionMode="Multiple"
          SelectionChanged="OnSelectionChanged"
          HorizontalContentAlignment="Stretch"
        >
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:ManagedHistoryRow">
              <Grid ColumnSpacing="12" Padding="0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind CompletedText}" />
                <TextBlock
                  Grid.Column="1"
                  Text="{x:Bind RecordCountText}"
                  HorizontalAlignment="Right"
                />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <TextBlock
          x:Name="EmptyText"
          Grid.Row="2"
          Text="このドライブには保存された履歴がありません。"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        />
      </Grid>
    </Border>
    <TextBlock
      Grid.Row="3"
      Text="スキャン履歴のみを削除します。実ファイルには影響しません。DBの空き領域は再利用されるため、ファイル容量がすぐ縮むとは限りません。"
      FontSize="12"
      TextWrapping="Wrap"
      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
    />
    <InfoBar
      x:Name="Notice"
      Grid.RowSpan="4"
      Canvas.ZIndex="10"
      HorizontalAlignment="Right"
      VerticalAlignment="Bottom"
      MaxWidth="520"
      Margin="16"
      IsOpen="False"
      IsClosable="True"
      AutomationProperties.LiveSetting="Polite"
    />
  </Grid>
</UserControl>
