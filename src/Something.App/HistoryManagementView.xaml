<UserControl
  x:Class="Something.App.HistoryManagementView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Something.App"
>
  <UserControl.Resources>
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
    <Style
      x:Key="GhostButtonStyle"
      TargetType="Button"
      BasedOn="{StaticResource DefaultButtonStyle}"
    >
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
  </UserControl.Resources>
  <Grid RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border
      Padding="0,0,0,16"
      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
      BorderThickness="0,0,0,1"
    >
      <StackPanel x:Name="SelectionControls" Spacing="12">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border
            CornerRadius="6"
            BorderThickness="1"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            Padding="4"
          >
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button
                x:Uid="HistoryManagement_FromRangeButton"
                x:Name="FromRangeButton"
                Background="Transparent"
                BorderThickness="0"
                Padding="12,8"
              >
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <FontIcon Glyph="&#xE787;" FontSize="16" />
                  <TextBlock x:Name="FromValueText" Text="—" MinWidth="160" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="Bottom">
                    <StackPanel Spacing="12">
                      <CalendarDatePicker
                        x:Uid="HistoryManagement_FromDate"
                        x:Name="FromDate"
                        DateChanged="OnDateChanged"
                        Width="220"
                      />
                      <TimePicker
                        x:Uid="HistoryManagement_FromTime"
                        x:Name="FromTime"
                        ClockIdentifier="24HourClock"
                        TimeChanged="OnTimeChanged"
                      />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <TextBlock
                Text="–"
                VerticalAlignment="Center"
                Margin="4,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              />
              <Button
                x:Uid="HistoryManagement_EndRangeButton"
                x:Name="EndRangeButton"
                Background="Transparent"
                BorderThickness="0"
                Padding="12,8"
              >
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <FontIcon Glyph="&#xE787;" FontSize="16" />
                  <TextBlock x:Name="EndValueText" Text="—" MinWidth="160" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="Bottom">
                    <StackPanel Spacing="12">
                      <CalendarDatePicker
                        x:Uid="HistoryManagement_EndDate"
                        x:Name="EndDate"
                        DateChanged="OnDateChanged"
                        Width="220"
                      />
                      <TimePicker
                        x:Uid="HistoryManagement_EndTime"
                        x:Name="EndTime"
                        ClockIdentifier="24HourClock"
                        TimeChanged="OnTimeChanged"
                      />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button
                x:Uid="HistoryManagement_ClearRangeButton"
                x:Name="ClearRangeButton"
                Click="OnClearRange"
                Background="Transparent"
                BorderThickness="0"
                Padding="8"
                VerticalAlignment="Center"
              >
                <FontIcon Glyph="&#xE711;" FontSize="12" />
              </Button>
            </StackPanel>
          </Border>
          <Button
            x:Uid="HistoryManagement_ApplyRangeButton"
            x:Name="ApplyRangeButton"
            Grid.Column="1"
            Style="{StaticResource GhostButtonStyle}"
            Width="36"
            Height="36"
            MinWidth="0"
            Padding="0"
            Click="OnApplyRange"
            VerticalAlignment="Center"
          >
            <FontIcon Glyph="&#xE73E;" FontSize="18" />
          </Button>
          <Button
            x:Uid="HistoryManagement_OptimizeButton"
            x:Name="OptimizeButton"
            Style="{StaticResource GhostButtonStyle}"
            Grid.Column="4"
            Click="OnOptimize"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          >
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE90F;" FontSize="16" />
              <TextBlock x:Uid="HistoryManagement_OptimizeButtonText" />
            </StackPanel>
          </Button>
          <TextBlock
            x:Name="DatabaseSizeText"
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          />
        </Grid>
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
              x:Uid="HistoryManagement_MonthPresetButton"
              x:Name="MonthPresetButton"
              Style="{StaticResource GhostButtonStyle}"
              Tag="1"
              Click="OnPresetClick"
            />
            <Button
              x:Uid="HistoryManagement_ThreeMonthsPresetButton"
              x:Name="ThreeMonthsPresetButton"
              Style="{StaticResource GhostButtonStyle}"
              Tag="3"
              Click="OnPresetClick"
            />
            <Button
              x:Uid="HistoryManagement_HalfYearPresetButton"
              x:Name="HalfYearPresetButton"
              Style="{StaticResource GhostButtonStyle}"
              Tag="6"
              Click="OnPresetClick"
            />
            <Button
              x:Uid="HistoryManagement_YearPresetButton"
              x:Name="YearPresetButton"
              Style="{StaticResource GhostButtonStyle}"
              Tag="12"
              Click="OnPresetClick"
            />
          </StackPanel>
        </Grid>

        <TextBlock
          x:Name="SelectionError"
          Visibility="Collapsed"
          TextWrapping="Wrap"
          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
        />
      </StackPanel>
    </Border>
    <Border Grid.Row="2">
      <Grid RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock x:Uid="HistoryManagement_Title" FontSize="20" FontWeight="SemiBold" />
            <TextBlock
              x:Uid="HistoryManagement_TotalText"
              x:Name="TotalText"
              VerticalAlignment="Center"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
            <TextBlock
              x:Uid="HistoryManagement_SelectionCountText"
              x:Name="SelectionCountText"
              VerticalAlignment="Center"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              AutomationProperties.LiveSetting="Polite"
            />
            <Button
              x:Name="DeleteButton"
              Style="{StaticResource GhostButtonStyle}"
              Click="OnDelete"
              IsEnabled="False"
              Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            >
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE74D;" FontSize="16" />
                <TextBlock x:Uid="HistoryManagement_DeleteButtonText" />
              </StackPanel>
            </Button>
            <ProgressRing
              x:Name="BusyRing"
              Grid.Column="1"
              Width="20"
              Height="20"
              IsActive="False"
              Visibility="Collapsed"
            />
          </StackPanel>
        </Grid>
        <Border
          x:Name="HistoryHeaderBand"
          Grid.Row="1"
          Style="{StaticResource ListHeaderBandStyle}"
        >
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="178" />
            </Grid.ColumnDefinitions>
            <CheckBox
              x:Uid="HistoryManagement_SelectAllCheckBox"
              x:Name="SelectAllCheckBox"
              HorizontalAlignment="Left"
              Margin="16,0,0,0"
              MinWidth="0"
              Width="20"
              MinHeight="0"
              IsEnabled="False"
              IsThreeState="False"
              Click="OnToggleAll"
            />
            <Button
              x:Uid="HistoryManagement_CompletedHeader"
              x:Name="CompletedHeader"
              Padding="8,6,6,6"
              Grid.Column="1"
              Tag="Completed"
              Click="OnHistorySort"
              Style="{StaticResource ColumnHeaderButtonStyle}"
            />
            <Button
              x:Uid="HistoryManagement_RecordCountHeader"
              x:Name="RecordCountHeader"
              Padding="6,6,12,6"
              Grid.Column="2"
              Tag="Count"
              Click="OnHistorySort"
              Style="{StaticResource ColumnHeaderButtonStyle}"
              HorizontalContentAlignment="Right"
            />
          </Grid>
        </Border>
        <ListView
          x:Name="HistoryList"
          ItemContainerStyle="{StaticResource ListRowContainerStyle}"
          Grid.Row="2"
          SelectionMode="Multiple"
          SelectionChanged="OnSelectionChanged"
          HorizontalContentAlignment="Stretch"
        >
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:ManagedHistoryRow">
              <Grid ColumnSpacing="12" Padding="0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind CompletedText}" />
                <TextBlock
                  Grid.Column="1"
                  Text="{x:Bind RecordCountText}"
                  HorizontalAlignment="Right"
                />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <TextBlock
          x:Uid="HistoryManagement_EmptyText"
          x:Name="EmptyText"
          Grid.Row="2"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        />
      </Grid>
    </Border>
    <TextBlock
      x:Uid="HistoryManagement_Footer"
      Grid.Row="3"
      FontSize="12"
      TextWrapping="Wrap"
      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
    />
    <InfoBar
      x:Name="Notice"
      Style="{StaticResource ToastStyle}"
      Grid.RowSpan="4"
      Canvas.ZIndex="10"
      IsOpen="False"
      AutomationProperties.LiveSetting="Polite"
    >
      <InfoBar.Resources>
        <ResourceDictionary Source="Styles/ToastPalette.xaml" />
      </InfoBar.Resources>
    </InfoBar>
  </Grid>
</UserControl>
