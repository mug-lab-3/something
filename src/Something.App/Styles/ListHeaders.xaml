<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <Thickness x:Key="ListContentPadding">16,0,12,0</Thickness>
  <Style
    x:Key="ListRowContainerStyle"
    TargetType="ListViewItem"
    BasedOn="{StaticResource DefaultListViewItemStyle}"
  >
    <Setter Property="Padding" Value="{StaticResource ListContentPadding}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style x:Key="ListHeaderBandStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="4,4,0,0" />
    <Setter Property="MinHeight" Value="40" />
  </Style>
  <Style x:Key="ListHeaderTextStyle" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
