<UserControl
  x:Class="Something.App.RecordLoadingAnimation"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Something.App"
  Width="300"
  Height="200"
  IsHitTestVisible="False"
  AutomationProperties.AccessibilityView="Raw"
>
  <UserControl.Resources>
    <LinearGradientBrush x:Key="DatabaseBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#BD619E" Offset="0" />
      <GradientStop Color="#743E80" Offset="1" />
    </LinearGradientBrush>
  </UserControl.Resources>
  <Canvas>
    <Canvas.Clip>
      <RectangleGeometry x:Name="AnimationClip" Rect="0,0,300,200" />
    </Canvas.Clip>
    <Canvas.Resources>
      <Storyboard x:Name="Cycle" Completed="OnCycleCompleted">
        <DoubleAnimationUsingKeyFrames x:Name="InspectGazeCycle" Storyboard.TargetProperty="X">
          <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.08" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.14" Value="-5" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.36" Value="-5" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.48" Value="5" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.7" Value="5" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.78" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.82" Value="0" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames
          x:Name="FrontFacingCycle"
          Storyboard.TargetProperty="Opacity"
        >
          <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:1.46" Value="0" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:1.82" Value="0" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames x:Name="SideFacingCycle" Storyboard.TargetProperty="Opacity">
          <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:1.46" Value="1" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:1.82" Value="1" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames
          Storyboard.TargetName="ChickMotion"
          Storyboard.TargetProperty="TranslateX"
        >
          <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
          <SplineDoubleKeyFrame KeyTime="0:0:0.86" Value="0" KeySpline="0.2,0,0.2,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:1.14" Value="136" KeySpline="0.2,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.46" Value="136" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.82" Value="260" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames
          Storyboard.TargetName="ChickMotion"
          Storyboard.TargetProperty="TranslateY"
        >
          <!-- Peek over the rim, look around, dip to push off, then leap forward. -->
          <LinearDoubleKeyFrame KeyTime="0:0:0" Value="42" />
          <SplineDoubleKeyFrame KeyTime="0:0:0.08" Value="20" KeySpline="0.2,0,0.2,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.78" Value="20" />
          <SplineDoubleKeyFrame KeyTime="0:0:0.84" Value="28" KeySpline="0.4,0,0.8,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.86" Value="30" />
          <SplineDoubleKeyFrame KeyTime="0:0:0.98" Value="-38" KeySpline="0,0.65,0.25,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:1.14" Value="22" KeySpline="0.4,0,0.8,1" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.46" Value="22" />
          <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="19" KeySpline="0.2,0,0.8,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:1.56" Value="22" KeySpline="0.2,0,0.8,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:1.62" Value="19" KeySpline="0.2,0,0.8,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:1.68" Value="22" KeySpline="0.2,0,0.8,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:1.74" Value="19" KeySpline="0.2,0,0.8,1" />
          <SplineDoubleKeyFrame KeyTime="0:0:1.82" Value="22" KeySpline="0.2,0,0.8,1" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames
          Storyboard.TargetName="ChickMotion"
          Storyboard.TargetProperty="Rotation"
        >
          <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.08" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.14" Value="-2" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.36" Value="-2" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.48" Value="2" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.7" Value="2" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.78" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.86" Value="7" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.94" Value="-7" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.06" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.14" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.46" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="3" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.56" Value="-3" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.62" Value="3" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.68" Value="-3" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.74" Value="3" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.82" Value="0" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames
          Storyboard.TargetName="Chick"
          Storyboard.TargetProperty="Opacity"
        >
          <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.04" Value="1" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.81" Value="1" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:1.82" Value="0" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames x:Name="LeftFootCycle" Storyboard.TargetProperty="Angle">
          <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.78" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.86" Value="-25" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.98" Value="15" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.1" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.46" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="-25" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.56" Value="25" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.62" Value="-25" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.68" Value="25" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.74" Value="-25" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.82" Value="0" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames x:Name="RightFootCycle" Storyboard.TargetProperty="Angle">
          <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.78" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.86" Value="25" />
          <LinearDoubleKeyFrame KeyTime="0:0:0.98" Value="-15" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.1" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.46" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="25" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.56" Value="-25" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.62" Value="25" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.68" Value="-25" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.74" Value="25" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.82" Value="0" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames
          Storyboard.TargetName="ScanBeamMotion"
          Storyboard.TargetProperty="Y"
        >
          <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.12" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.44" Value="64" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.82" Value="64" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames
          Storyboard.TargetName="ScanBeam"
          Storyboard.TargetProperty="Opacity"
        >
          <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:1.12" Value="1" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.42" Value="1" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.46" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.82" Value="0" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames
          Storyboard.TargetName="GateReady"
          Storyboard.TargetProperty="Opacity"
        >
          <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:1.44" Value="1" />
          <LinearDoubleKeyFrame KeyTime="0:0:1.81" Value="1" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:1.82" Value="0" />
        </DoubleAnimationUsingKeyFrames>
      </Storyboard>
    </Canvas.Resources>
    <Canvas>
      <Canvas.RenderTransform>
        <TranslateTransform x:Name="SceneOffset" Y="28" />
      </Canvas.RenderTransform>
      <Canvas x:Name="ScanCrane" Canvas.ZIndex="2" Visibility="Collapsed">
        <Path
          Data="M 64,4 H 234"
          Stroke="#776781"
          StrokeThickness="3"
          StrokeStartLineCap="Round"
          StrokeEndLineCap="Round"
        />
        <Canvas>
          <Canvas.RenderTransform>
            <TranslateTransform x:Name="CraneTravel" X="78" />
          </Canvas.RenderTransform>
          <Rectangle
            Canvas.Left="-10"
            Width="20"
            Height="8"
            RadiusX="4"
            RadiusY="4"
            Fill="#C9B0E5"
          />
          <Rectangle Canvas.Left="-1" Canvas.Top="4" Width="2" Height="1" Fill="#B5A4C5">
            <Rectangle.RenderTransform>
              <ScaleTransform x:Name="CraneCable" ScaleY="4" />
            </Rectangle.RenderTransform>
          </Rectangle>
          <Canvas>
            <Canvas.RenderTransform>
              <TranslateTransform x:Name="CraneLift" Y="8" />
            </Canvas.RenderTransform>
            <Path
              Data="M -10,0 L -33,27 L -30,51 Q -28,56 -21,55"
              Stroke="#D9C6EC"
              StrokeThickness="4"
              StrokeLineJoin="Round"
              StrokeEndLineCap="Round"
            >
              <Path.RenderTransform>
                <RotateTransform x:Name="CraneLeftArm" CenterX="-10" Angle="25" />
              </Path.RenderTransform>
            </Path>
            <Path
              Data="M 10,0 L 33,27 L 30,51 Q 28,56 21,55"
              Stroke="#D9C6EC"
              StrokeThickness="4"
              StrokeLineJoin="Round"
              StrokeEndLineCap="Round"
            >
              <Path.RenderTransform>
                <RotateTransform x:Name="CraneRightArm" CenterX="10" Angle="-25" />
              </Path.RenderTransform>
            </Path>
            <Rectangle
              Canvas.Left="-14"
              Canvas.Top="-4"
              Width="28"
              Height="12"
              RadiusX="6"
              RadiusY="6"
              Fill="#A684BB"
            />
            <Ellipse Canvas.Left="-3" Width="6" Height="6" Fill="#E8D7EF" />
          </Canvas>
        </Canvas>
      </Canvas>
      <Canvas x:Name="DiskSource" Visibility="Collapsed">
        <Rectangle
          Canvas.Left="24"
          Canvas.Top="94"
          Width="108"
          Height="34"
          RadiusX="8"
          RadiusY="8"
          Fill="#9296AE"
        />
        <Ellipse Canvas.Left="24" Canvas.Top="112" Width="108" Height="28" Fill="#9296AE" />
        <Ellipse
          Canvas.Left="24"
          Canvas.Top="80"
          Width="108"
          Height="30"
          Fill="#CFD0DF"
          Stroke="#E8E3F0"
          StrokeThickness="2"
        />
        <Ellipse Canvas.Left="37" Canvas.Top="84" Width="82" Height="21" Fill="#ACADC7" />
        <Ellipse Canvas.Left="69" Canvas.Top="90" Width="18" Height="9" Fill="#6B6684" />
      </Canvas>
      <Canvas>
        <Canvas.RenderTransform>
          <TranslateTransform x:Name="DatabaseBackMotion" />
        </Canvas.RenderTransform>
        <!-- The back of the nest sits behind the database base. -->
        <Canvas x:Name="NestBack" Canvas.Top="55">
          <Canvas.RenderTransform>
            <ScaleTransform CenterX="88" CenterY="110" ScaleX="1.15" ScaleY="1.1" />
          </Canvas.RenderTransform>
          <!-- A solid inner bowl fills the space between the database and the woven rim. -->
          <Ellipse Canvas.Left="30" Canvas.Top="68" Width="116" Height="40" Fill="#96725E" />
          <Path
            Data="M 30,80 C 33,55 143,55 149,80"
            Stroke="#997467"
            StrokeThickness="8"
            StrokeStartLineCap="Round"
            StrokeEndLineCap="Round"
          />
          <Path
            Data="M 34,75 C 52,57 129,57 144,75 M 40,67 L 30,59 M 52,63 L 48,55 M 124,63 L 132,55 M 138,68 L 151,63"
            Stroke="#C7A382"
            StrokeThickness="3"
            StrokeStartLineCap="Round"
            StrokeEndLineCap="Round"
          />
          <Path
            Data="M 35,71 L 27,69 M 57,61 L 65,55 M 111,61 L 107,55 M 144,75 L 155,72"
            Stroke="#AE8871"
            StrokeThickness="2.5"
            StrokeStartLineCap="Round"
            StrokeEndLineCap="Round"
          />
        </Canvas>
        <!-- Stacked cylinders keep the database metaphor; the recessed top is the nest. -->
        <Rectangle
          Canvas.Left="38"
          Canvas.Top="83"
          Width="100"
          Height="53"
          Fill="{StaticResource DatabaseBrush}"
        />
        <Ellipse
          Canvas.Left="38"
          Canvas.Top="119"
          Width="100"
          Height="30"
          Fill="{StaticResource DatabaseBrush}"
        />
        <Path
          Data="M 38,104 C 38,123 138,123 138,104 M 38,122 C 38,141 138,141 138,122"
          Stroke="#D998C8"
          StrokeThickness="2"
          Opacity="0.7"
        />
        <Ellipse
          Canvas.Left="38"
          Canvas.Top="65"
          Width="100"
          Height="35"
          Fill="#65365F"
          Stroke="#E6ACD5"
          StrokeThickness="3"
        />
        <Ellipse Canvas.Left="48" Canvas.Top="72" Width="80" Height="21" Fill="#4F2E50" />
      </Canvas>
      <!-- The scanner stays still while each record walks through its open arch. -->
      <Path
        x:Name="ScannerArch"
        Data="M 182,132 L 182,50 Q 182,40 192,40 L 256,40 Q 266,40 266,50 L 266,132"
        Stroke="#C9B0E5"
        StrokeThickness="8"
        StrokeLineJoin="Round"
      />
      <Ellipse
        x:Name="ScannerLamp"
        Canvas.Left="250"
        Canvas.Top="43"
        Width="7"
        Height="7"
        Fill="#8B709F"
      />
      <Ellipse
        x:Name="GateReady"
        Canvas.Left="250"
        Canvas.Top="43"
        Width="7"
        Height="7"
        Fill="#8CE4AD"
        Opacity="0"
      />
      <Canvas x:Name="Chick" Canvas.Left="61" Canvas.Top="38" Width="54" Height="68" Opacity="0">
        <Canvas.RenderTransform>
          <CompositeTransform x:Name="ChickMotion" CenterX="27" CenterY="55" TranslateY="35" />
        </Canvas.RenderTransform>
        <local:ChickFigure x:Name="DefaultChick" />
      </Canvas>
      <local:ChickFigure x:Name="OptimizeFirst" Canvas.Top="80" Visibility="Collapsed">
        <local:ChickFigure.RenderTransform>
          <CompositeTransform
            x:Name="OptimizeFirstMotion"
            CenterX="27"
            CenterY="68"
            ScaleX="1"
            ScaleY="1"
          />
        </local:ChickFigure.RenderTransform>
      </local:ChickFigure>
      <local:ChickFigure x:Name="OptimizeSecond" Canvas.Top="80" Visibility="Collapsed">
        <local:ChickFigure.RenderTransform>
          <CompositeTransform
            x:Name="OptimizeSecondMotion"
            CenterX="27"
            CenterY="68"
            ScaleX="1"
            ScaleY="1"
          />
        </local:ChickFigure.RenderTransform>
      </local:ChickFigure>
      <local:ChickFigure x:Name="OptimizeThird" Canvas.Top="80" Visibility="Collapsed">
        <local:ChickFigure.RenderTransform>
          <CompositeTransform
            x:Name="OptimizeThirdMotion"
            CenterX="27"
            CenterY="68"
            ScaleX="1"
            ScaleY="1"
          />
        </local:ChickFigure.RenderTransform>
      </local:ChickFigure>
      <Canvas x:Name="OptimizationConversation" Canvas.ZIndex="2" Visibility="Collapsed">
        <Canvas x:Name="FirstTalk" Canvas.Left="28" Canvas.Top="44" Opacity="0">
          <Path
            Data="M 0,0 H 32 Q 36,0 36,5 V 17 Q 36,22 31,22 H 15 L 8,28 L 9,22 H 5 Q 0,22 0,17 Z"
            Fill="#574360"
            Stroke="#D2B3E3"
          />
          <Path
