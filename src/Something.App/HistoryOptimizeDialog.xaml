<ContentDialog
  x:Class="Something.App.HistoryOptimizeDialog"
  Style="{StaticResource DefaultContentDialogStyle}"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="DBを最適化しますか？"
  PrimaryButtonText="最適化する"
  CloseButtonText="キャンセル"
  DefaultButton="None"
  PrimaryButtonStyle="{StaticResource ConfirmationDialogButtonStyle}"
  CloseButtonStyle="{StaticResource SecondaryDialogButtonStyle}"
>
  <StackPanel Spacing="12">
    <TextBlock
      Text="全ドライブ共通の履歴DBを詰め直し、不要な領域を整理します。"
      TextWrapping="Wrap"
    />
    <TextBlock
      Text="DBの容量や記録数によっては、処理に時間がかかる場合があります。追加の空き容量が必要です。"
      TextWrapping="Wrap"
      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
    />
  </StackPanel>
</ContentDialog>
