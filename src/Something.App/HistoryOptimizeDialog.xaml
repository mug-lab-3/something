<ContentDialog
  x:Class="Something.App.HistoryOptimizeDialog"
  Style="{StaticResource DefaultContentDialogStyle}"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="データベースを最適化しますか？"
  PrimaryButtonText="最適化"
  CloseButtonText="キャンセル"
  DefaultButton="None"
  PrimaryButtonStyle="{StaticResource ConfirmationDialogButtonStyle}"
  CloseButtonStyle="{StaticResource SecondaryDialogButtonStyle}"
>
  <StackPanel Spacing="12">
    <TextBlock
      Text="全ドライブ共通の履歴データベースから不要な領域を解放し、ファイルサイズを縮小します。"
      TextWrapping="Wrap"
    />
    <TextBlock
      Text="データベースのサイズによっては、時間がかかる場合があります。追加の空き容量が必要です。"
      TextWrapping="Wrap"
      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
    />
  </StackPanel>
</ContentDialog>
