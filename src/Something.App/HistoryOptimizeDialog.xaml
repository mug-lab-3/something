<ContentDialog
  x:Uid="HistoryOptimizeDialog"
  x:Class="Something.App.HistoryOptimizeDialog"
  Style="{StaticResource DefaultContentDialogStyle}"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  DefaultButton="None"
  PrimaryButtonStyle="{StaticResource ConfirmationDialogButtonStyle}"
  CloseButtonStyle="{StaticResource SecondaryDialogButtonStyle}"
>
  <StackPanel Spacing="12">
    <TextBlock x:Uid="HistoryOptimize_Description" TextWrapping="Wrap" />
    <TextBlock
      x:Uid="HistoryOptimize_Hint"
      TextWrapping="Wrap"
      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
    />
  </StackPanel>
</ContentDialog>
