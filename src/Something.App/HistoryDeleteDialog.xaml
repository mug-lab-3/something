<ContentDialog
  x:Uid="HistoryDeleteDialog"
  x:Class="Something.App.HistoryDeleteDialog"
  Style="{StaticResource DefaultContentDialogStyle}"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  PrimaryButtonStyle="{StaticResource ConfirmationDialogButtonStyle}"
  CloseButtonStyle="{StaticResource SecondaryDialogButtonStyle}"
  DefaultButton="None"
>
  <StackPanel Spacing="16">
    <TextBlock
      x:Name="RangeText"
      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
      TextWrapping="Wrap"
    />
    <TextBlock x:Uid="HistoryDelete_Warning" TextWrapping="Wrap" />
    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
    <CheckBox
      x:Uid="HistoryDelete_OptimizeAfterDelete"
      x:Name="OptimizeAfterDelete"
      IsChecked="False"
    />
    <TextBlock
      x:Uid="HistoryDelete_OptimizeHint"
      Margin="32,0,0,0"
      FontSize="12"
      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
      TextWrapping="Wrap"
    />
  </StackPanel>
</ContentDialog>
