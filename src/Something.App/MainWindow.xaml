<Window
  x:Class="Something.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Something.App"
>
  <Grid x:Name="WindowLayout" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TitleBar
      x:Name="AppTitleBar"
      Title="Something"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
      <TitleBar.IconSource>
        <ImageIconSource ImageSource="ms-appx:///Assets/app-icon.png" />
      </TitleBar.IconSource>
    </TitleBar>
    <Grid
      x:Name="RootLayout"
      Grid.Row="1"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      Padding="24"
      RowSpacing="16"
    >
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ScrollViewer
        x:Name="DriveScroll"
        Grid.Row="0"
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Enabled"
        VerticalScrollMode="Disabled"
      >
        <StackPanel x:Name="DriveCards" Margin="0,0,0,16" Orientation="Horizontal" Spacing="12" />
      </ScrollViewer>
      <TabView
        x:Name="WorkspaceTabs"
        Grid.Row="1"
        SelectedIndex="0"
        IsAddTabButtonVisible="False"
        CanDragTabs="False"
        CanReorderTabs="False"
        TabWidthMode="SizeToContent"
        SelectionChanged="OnWorkspaceChanged"
      >
        <TabViewItem
          Style="{StaticResource UnderlineTabStyle}"
          IsClosable="False"
          AutomationProperties.Name="ファイル"
        >
          <TabViewItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Glyph="&#xE8B7;" FontSize="18" />
              <TextBlock Text="ファイル" />
            </StackPanel>
          </TabViewItem.Header>
        </TabViewItem>
        <TabViewItem
          x:Name="AnalysisWorkspaceTab"
          Style="{StaticResource UnderlineTabStyle}"
          IsClosable="False"
          AutomationProperties.Name="容量分析"
        >
          <TabViewItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Glyph="&#xE9D9;" FontSize="18" />
              <TextBlock Text="容量分析" />
            </StackPanel>
          </TabViewItem.Header>
        </TabViewItem>
        <TabViewItem
          x:Name="DatabaseWorkspaceTab"
          Style="{StaticResource UnderlineTabStyle}"
          IsClosable="False"
          AutomationProperties.Name="DB管理"
        >
          <TabViewItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Glyph="&#xE1D3;" FontSize="18" />
              <TextBlock Text="DB管理" />
            </StackPanel>
          </TabViewItem.Header>
        </TabViewItem>
      </TabView>
      <local:HistoryManagementView
        x:Name="HistoryManagement"
        Grid.Row="2"
        Grid.RowSpan="2"
        Visibility="Collapsed"
      />
      <ContentControl
        x:Name="ViewHost"
        Grid.Row="2"
        Grid.RowSpan="2"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
      >
        <Grid RowSpacing="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel x:Name="ViewControls" Grid.Row="0" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <ComboBox
                x:Name="HistoryBox"
                ToolTipService.ToolTip="表示するスキャンの取得日時を選択します。履歴は直近7日間の全記録と、それ以前の各日の最終記録を保持します。"
                Header="表示する記録"
                Width="250"
                PlaceholderText="最新のスキャン"
                IsEnabled="False"
                SelectionChanged="OnHistoryChanged"
                AutomationProperties.Name="表示するスキャン"
              />
              <ComboBox
                x:Name="ComparisonPeriodBox"
                Header="比較"
                Width="150"
                SelectionChanged="OnComparisonOptionsChanged"
                AutomationProperties.Name="比較期間"
              />
              <StackPanel
                x:Name="CustomComparisonPanel"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="Collapsed"
              >
                <ComboBox
                  x:Name="ComparisonBeforeBox"
                  Header="比較元のスキャン"
                  Width="250"
                  PlaceholderText="比較前"
                  SelectionChanged="OnComparisonOptionsChanged"
                  AutomationProperties.Name="比較前のスキャン"
                />
              </StackPanel>
              <Button
                Background="Transparent"
                BorderThickness="0"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="サイズ集計について"
                ToolTipService.ToolTip="サイズはディスク上のDATA容量です。フォルダはサブフォルダ込みで集計し、ハードリンクは名前ごとに計上します。リンク先はたどりません。表示はスキャン取得時点の観測です。"
              >
                <FontIcon Glyph="&#xE946;" FontSize="16" />
              </Button>
            </StackPanel>
            <Border
              x:Name="ComparisonRangePanel"
              Visibility="Collapsed"
              Padding="12,8"
              CornerRadius="6"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            >
              <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock x:Name="SelectedBeforeText" Text="比較前：—" FontWeight="SemiBold" />
                <TextBlock Text="→" />
                <TextBlock x:Name="SelectedAfterText" Text="比較後：—" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <TextBlock
              x:Name="ComparisonStatusText"
              Visibility="Collapsed"
              TextWrapping="Wrap"
              FontSize="12"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            />
          </StackPanel>
          <Grid x:Name="ResultsContent" Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="TreeColumn" Width="250" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
              x:Name="TreePanel"
              CornerRadius="8"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              Padding="8"
            >
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="フォルダ" FontWeight="SemiBold" Margin="8,6,8,12" />
                <TreeView
                  x:Name="Folders"
                  Grid.Row="1"
                  SelectionMode="Single"
                  Loaded="OnTreeLoaded"
                  SelectionChanged="OnTreeSelectionChanged"
                  SizeChanged="OnTreeSizeChanged"
                  Expanding="OnExpanding"
                  ItemInvoked="OnFolderInvoked"
                  ContextRequested="OnTreeContextRequested"
                >
                  <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                  </TreeView.ItemContainerStyle>
                  <TreeView.ItemTemplate>
                    <DataTemplate>
                      <Grid
                        ColumnSpacing="4"
                        ToolTipService.ToolTip="{Binding Content.Description}"
                      >
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="{Binding Content.ChangeWidth}" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                          x:Name="TreeChangeIcon"
                          Glyph="{Binding Content.ChangeGlyph}"
                          Foreground="{Binding Content.ChangeBrush}"
                          FontSize="14"
                          AutomationProperties.Name="{Binding Content.ChangeDescription}"
                        />
                        <TextBlock
                          x:Name="FolderNameText"
                          Grid.Column="1"
                          Text="{Binding Content.DisplayName}"
                          TextTrimming="CharacterEllipsis"
                        />
                        <ProgressRing
                          x:Name="TreeLoadingRing"
                          Grid.Column="2"
                          Width="14"
                          Height="14"
                          IsActive="{Binding Content.IsLoading}"
                          Visibility="{Binding Content.LoadingVisibility}"
                          AutomationProperties.Name="子フォルダーを読み込み中"
                        />
                      </Grid>
                    </DataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
              </Grid>
            </Border>
            <Grid x:Name="FileListPanel" Grid.Column="1" RowSpacing="12">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="フォルダ内" />
                <TextBlock
                  x:Name="EntryCountText"
                  Text="{Binding TotalCountText}"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  ToolTipService.ToolTip="{Binding CountDescription}"
                />
              </StackPanel>
              <local:DelayedLoadingRegion x:Name="EntryLoadingRegion" Grid.Row="1">
                <local:DelayedLoadingRegion.Body>
                  <Grid Padding="12" RowSpacing="12">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <StackPanel.Resources>
                          <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                          <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                            <Setter Property="Width" Value="32" />
                            <Setter Property="Height" Value="32" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="CornerRadius" Value="4" />
                          </Style>
                        </StackPanel.Resources>
                        <Button
                          x:Name="BackButton"
                          Click="OnBack"
                          IsEnabled="False"
                          ToolTipService.ToolTip="戻る"
                          AutomationProperties.Name="戻る"
                        >
                          <FontIcon Glyph="&#xE72B;" FontSize="16" />
                        </Button>
                        <Button
                          x:Name="ForwardButton"
                          Click="OnForward"
                          IsEnabled="False"
                          ToolTipService.ToolTip="進む"
                          AutomationProperties.Name="進む"
                        >
                          <FontIcon Glyph="&#xE72A;" FontSize="16" />
                        </Button>
                        <Button
                          x:Name="UpButton"
                          Click="OnUp"
                          IsEnabled="False"
                          ToolTipService.ToolTip="上へ（親フォルダ）"
                          AutomationProperties.Name="親フォルダへ移動"
                        >
                          <FontIcon Glyph="&#xE74A;" FontSize="16" />
                        </Button>
                      </StackPanel>
                      <TextBlock
                        x:Name="PathText"
                        Grid.Column="1"
                        Text="未スキャン"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{Binding Text, ElementName=PathText}"
                        ContextRequested="OnPathContextRequested"
                      />
                    </Grid>
                    <Grid Grid.Row="1" Padding="12,0" ColumnSpacing="12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition x:Name="ChangeHeaderColumn" Width="0" />
                      </Grid.ColumnDefinitions>
                      <Button
                        x:Name="EntryNameHeader"
                        Grid.Column="1"
                        Content="名前"
                        Tag="Name"
                        Click="OnEntrySort"
                        Style="{StaticResource ColumnHeaderButtonStyle}"
                      />
                      <Button
                        Grid.Column="2"
                        x:Name="SizeColumnText"
                        Content="サイズ"
                        ToolTipService.ToolTip="ディスク上の割り当て容量"
                        Tag="Size"
                        Click="OnEntrySort"
                        Style="{StaticResource ColumnHeaderButtonStyle}"
                      />
                      <Button
                        x:Name="ChangeHeader"
                        Grid.Column="3"
                        Content="増減"
                        Visibility="Collapsed"
                        Tag="Change"
                        Click="OnEntrySort"
                        Style="{StaticResource ColumnHeaderButtonStyle}"
                      />
                    </Grid>
                    <ListView
                      x:Name="Entries"
                      Grid.Row="2"
                      DoubleTapped="OnEntryInvoked"
                      ContextRequested="OnEntryContextRequested"
                      SelectionMode="Single"
                    >
                      <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:EntryRow" xmlns:local="using:Something.App">
                          <Grid ColumnSpacing="12" Padding="0,8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="24" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="140" />
                              <ColumnDefinition Width="{x:Bind ComparisonWidth}" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon
                              Symbol="{x:Bind Icon}"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              ToolTipService.ToolTip="{x:Bind Kind}"
                              AutomationProperties.Name="{x:Bind Kind}"
                            />
                            <TextBlock
                              Grid.Column="1"
                              Text="{x:Bind Name}"
                              TextTrimming="CharacterEllipsis"
                              ToolTipService.ToolTip="{x:Bind NameDescription}"
                            />
                            <TextBlock
                              Grid.Column="2"
                              Text="{x:Bind Size}"
                              ToolTipService.ToolTip="{x:Bind SizeDescription}"
                            />
                            <TextBlock
                              Grid.Column="3"
                              Text="{x:Bind Delta}"
                              ToolTipService.ToolTip="{x:Bind SizeDescription}"
                            />
                          </Grid>
                        </DataTemplate>
                      </ListView.ItemTemplate>
                    </ListView>
                  </Grid>
                </local:DelayedLoadingRegion.Body>
              </local:DelayedLoadingRegion>
            </Grid>
            <local:DelayedLoadingRegion
              x:Name="RankingLoadingRegion"
              Grid.ColumnSpan="2"
              Visibility="Collapsed"
            >
              <local:DelayedLoadingRegion.Body>
                <Grid Padding="12" RowSpacing="12">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                      x:Name="LeafBox"
                      Content="最下位フォルダのみ"
                      Checked="OnLeafChanged"
                      Unchecked="OnLeafChanged"
                      VerticalAlignment="Bottom"
                    />
                    <TextBlock
                      x:Name="AnalysisCountText"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      AutomationProperties.LiveSetting="Polite"
                    />
                  </Grid>
                  <Grid Grid.Row="1" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="140" />
                      <ColumnDefinition x:Name="RankingChangeColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Button
                      x:Name="AnalysisNameHeader"
                      Content="フォルダ"
                      Tag="Name"
                      Click="OnAnalysisSort"
                      Style="{StaticResource ColumnHeaderButtonStyle}"
                    />
                    <Button
                      x:Name="RankingChangeHeader"
                      Grid.Column="2"
                      Content="増減"
                      Visibility="Collapsed"
                      Tag="Change"
                      Click="OnAnalysisSort"
                      Style="{StaticResource ColumnHeaderButtonStyle}"
                    />
                    <Button
                      x:Name="AnalysisSizeHeader"
                      Grid.Column="1"
                      Content="サイズ"
                      Tag="Size"
                      Click="OnAnalysisSort"
                      Style="{StaticResource ColumnHeaderButtonStyle}"
                    />
                  </Grid>
                  <ListView
                    x:Name="Ranking"
                    Grid.Row="2"
                    DoubleTapped="OnRankInvoked"
                    ContextRequested="OnRankContextRequested"
                  >
                    <ListView.ItemTemplate>
                      <DataTemplate x:DataType="local:RankingRow" xmlns:local="using:Something.App">
                        <Grid Padding="0,8" ColumnSpacing="16">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="{x:Bind ComparisonWidth}" />
                          </Grid.ColumnDefinitions>
                          <TextBlock
                            Text="{x:Bind Path}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Path}"
                          />
                          <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind Size}"
                            ToolTipService.ToolTip="{x:Bind SizeDescription}"
                          />
                          <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind Delta}"
                            ToolTipService.ToolTip="{x:Bind SizeDescription}"
                          />
                        </Grid>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                </Grid>
              </local:DelayedLoadingRegion.Body>
            </local:DelayedLoadingRegion>
          </Grid>
          <TextBlock
            x:Name="EmptyScanText"
            Grid.Row="1"
            Text="ドライブカードのスキャンボタンから開始してください。"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            IsHitTestVisible="False"
          />
        </Grid>
      </ContentControl>
      <Border
        x:Name="ViewLoadingOverlay"
        Grid.Row="2"
        Grid.RowSpan="2"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        Visibility="Collapsed"
      >
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
          <local:RecordLoadingAnimation x:Name="ViewLoadingAnimation" />
          <TextBlock
            Text="表示を準備しています…"
            FontSize="18"
            FontWeight="SemiBold"
            HorizontalAlignment="Center"
          />
          <TextBlock
            x:Name="ViewLoadingText"
            HorizontalAlignment="Center"
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            AutomationProperties.LiveSetting="Polite"
          />
          <TextBlock
            Text="読み込みが完了すると、新しい表示に切り替わります。"
            FontSize="12"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          />
        </StackPanel>
      </Border>
      <InfoBar
        x:Name="MessageBar"
        Grid.RowSpan="4"
        Canvas.ZIndex="20"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        MaxWidth="560"
        Margin="16"
        IsOpen="False"
        IsClosable="True"
        AutomationProperties.LiveSetting="Polite"
      />
    </Grid>
  </Grid>
</Window>
