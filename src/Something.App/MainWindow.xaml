<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="Something.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Something.App"
>
  <Grid x:Name="WindowLayout" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TitleBar
      x:Name="AppTitleBar"
      Title="Something"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    >
      <TitleBar.IconSource>
        <ImageIconSource ImageSource="ms-appx:///Assets/app-icon.png" />
      </TitleBar.IconSource>
    </TitleBar>
    <ContentControl
      x:Name="StartupWorkspaceHost"
      Grid.Row="1"
      IsEnabled="False"
      HorizontalContentAlignment="Stretch"
      VerticalContentAlignment="Stretch"
    >
      <Grid
        x:Name="RootLayout"
        Grid.Row="1"
        Opacity="0"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        Padding="24"
        RowSpacing="16"
      >
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer
          x:Name="DriveScroll"
          Grid.Row="0"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Disabled"
          HorizontalScrollMode="Enabled"
          VerticalScrollMode="Disabled"
        >
          <StackPanel x:Name="DriveCards" Margin="0,0,0,16" Orientation="Horizontal" Spacing="12" />
        </ScrollViewer>
        <Grid Grid.Row="1" ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TabView
            x:Name="WorkspaceTabs"
            SelectedIndex="0"
            IsAddTabButtonVisible="False"
            CanDragTabs="False"
            CanReorderTabs="False"
            TabWidthMode="SizeToContent"
            SelectionChanged="OnWorkspaceChanged"
          >
            <TabViewItem
              x:Uid="Main_FilesTab"
              Style="{StaticResource UnderlineTabStyle}"
              IsClosable="False"
            >
              <TabViewItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Viewbox Width="20" Height="20">
                    <Canvas Width="28" Height="28">
                      <Path
                        Data="M3,8 H8 L11,11 H25 Q26,11 26,12 V25 Q26,26 25,26 H4 Q3,26 3,25 Z M11,11 V2 H20 L25,7 V11 M20,2 V7 H25 M14,6 H17 M14,9 H21"
                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                        StrokeThickness="1.6"
                      />
                    </Canvas>
                  </Viewbox>
                  <TextBlock x:Uid="Main_FilesTabText" />
                </StackPanel>
              </TabViewItem.Header>
            </TabViewItem>
            <TabViewItem
              x:Uid="Main_AnalysisTab"
              x:Name="AnalysisWorkspaceTab"
              Style="{StaticResource UnderlineTabStyle}"
              IsClosable="False"
            >
              <TabViewItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <FontIcon Glyph="&#xE9D9;" FontSize="18" />
                  <TextBlock x:Uid="Main_AnalysisTabText" />
                </StackPanel>
              </TabViewItem.Header>
            </TabViewItem>
            <TabViewItem
              x:Uid="Main_HistoryTab"
              x:Name="DatabaseWorkspaceTab"
              Style="{StaticResource UnderlineTabStyle}"
              IsClosable="False"
            >
              <TabViewItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <FontIcon Glyph="&#xE1D3;" FontSize="18" />
                  <TextBlock x:Uid="Main_HistoryTabText" />
                </StackPanel>
              </TabViewItem.Header>
            </TabViewItem>
          </TabView>
          <Button
            x:Uid="Main_SettingsButton"
            x:Name="SettingsButton"
            Click="OnOpenSettings"
            Grid.Column="1"
            Background="Transparent"
            BorderThickness="0"
            VerticalAlignment="Center"
          >
            <FontIcon Glyph="&#xE713;" FontSize="20" />
          </Button>
        </Grid>
        <local:HistoryManagementView
          x:Name="HistoryManagement"
          Grid.Row="2"
          Grid.RowSpan="2"
          Visibility="Collapsed"
        />
        <ContentControl
          x:Name="ViewHost"
          Grid.Row="2"
          Grid.RowSpan="2"
          HorizontalContentAlignment="Stretch"
          VerticalContentAlignment="Stretch"
        >
          <Grid RowSpacing="16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="ViewControls" Grid.Row="0" Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <ComboBox
                  x:Uid="Main_ComparisonPeriodBox"
                  x:Name="ComparisonPeriodBox"
                  Width="150"
                  SelectionChanged="OnComparisonPeriodChanged"
                />
                <ContentControl x:Name="NormalHistoryHost">
                  <local:HistoryPicker
                    x:Uid="Main_HistoryBox"
                    x:Name="HistoryBox"
                    Width="290"
                    IsEnabled="False"
                    SelectionChanged="OnHistoryChanged"
                  />
                </ContentControl>
                <Border
                  x:Name="CustomComparisonPanel"
                  Visibility="Collapsed"
                  HorizontalAlignment="Left"
                >
                  <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:HistoryPicker
                      x:Uid="Main_ComparisonBeforeBox"
                      x:Name="ComparisonBeforeBox"
                      Width="290"
                      SelectionChanged="OnComparisonOptionsChanged"
                    />
                    <FontIcon
                      x:Uid="Main_ComparisonArrow"
                      Grid.Column="1"
                      Glyph="&#xE72A;"
                      FontSize="18"
                      VerticalAlignment="Center"
                      Margin="0,24,0,0"
                    />
                    <ContentControl x:Name="CustomHistoryHost" Grid.Column="2" />
                  </Grid>
                </Border>
              </StackPanel>
              <TextBlock
                x:Name="ComparisonStatusText"
                Visibility="Collapsed"
                TextWrapping="Wrap"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              />
            </StackPanel>
            <Grid x:Name="ResultsContent" Grid.Row="1" ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="250" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border
                x:Name="TreePanel"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="8"
              >
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <TextBlock
                    x:Uid="Main_FolderTreeHeader"
                    FontWeight="SemiBold"
                    Margin="8,6,8,12"
                  />
                  <TreeView
                    x:Name="Folders"
                    Grid.Row="1"
                    SelectionMode="Single"
                    Loaded="OnTreeLoaded"
                    SelectionChanged="OnTreeSelectionChanged"
                    SizeChanged="OnTreeSizeChanged"
                    Expanding="OnExpanding"
                    ItemInvoked="OnFolderInvoked"
                    ContextRequested="OnTreeContextRequested"
                  >
                    <TreeView.ItemContainerStyle>
                      <Style TargetType="TreeViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                      <DataTemplate>
                        <Grid
                          ColumnSpacing="4"
                          ToolTipService.ToolTip="{Binding Content.Description}"
                        >
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Content.ChangeWidth}" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <FontIcon
                            x:Name="TreeChangeIcon"
                            Glyph="{Binding Content.ChangeGlyph}"
                            Foreground="{Binding Content.ChangeBrush}"
                            FontSize="14"
                            AutomationProperties.Name="{Binding Content.ChangeDescription}"
                          />
                          <TextBlock
                            x:Name="FolderNameText"
                            Grid.Column="1"
                            Text="{Binding Content.DisplayName}"
                            TextTrimming="CharacterEllipsis"
                          />
                          <ProgressRing
                            x:Uid="Main_TreeLoadingRing"
                            x:Name="TreeLoadingRing"
                            Grid.Column="2"
                            Width="14"
                            Height="14"
                            IsActive="{Binding Content.IsLoading}"
                            Visibility="{Binding Content.LoadingVisibility}"
                          />
                        </Grid>
                      </DataTemplate>
                    </TreeView.ItemTemplate>
                  </TreeView>
                </Grid>
              </Border>
              <Grid x:Name="BrowserPanel" Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12" Margin="12,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <StackPanel.Resources>
                      <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                      <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                        <Setter Property="Width" Value="32" />
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="4" />
                      </Style>
                    </StackPanel.Resources>
                    <Button
                      x:Uid="Main_BackButton"
                      x:Name="BackButton"
                      Click="OnBack"
                      IsEnabled="False"
                    >
                      <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    </Button>
                    <Button
                      x:Uid="Main_ForwardButton"
                      x:Name="ForwardButton"
                      Click="OnForward"
                      IsEnabled="False"
                    >
                      <FontIcon Glyph="&#xE72A;" FontSize="16" />
                    </Button>
                    <Button x:Uid="Main_UpButton" x:Name="UpButton" Click="OnUp" IsEnabled="False">
                      <FontIcon Glyph="&#xE74A;" FontSize="16" />
                    </Button>
                  </StackPanel>
                  <TextBlock
                    x:Uid="Main_PathText"
                    x:Name="PathText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{Binding Text, ElementName=PathText}"
                    ContextRequested="OnPathContextRequested"
                  />
                </Grid>
                <Grid x:Name="FileListPanel" RowSpacing="12" Grid.Row="1">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Uid="Main_FolderContentsLabel" />
                    <TextBlock
                      x:Name="EntryCountText"
                      Text="{Binding TotalCountText}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      ToolTipService.ToolTip="{Binding CountDescription}"
                    />
                  </StackPanel>
                  <local:DelayedLoadingRegion x:Name="EntryLoadingRegion" Grid.Row="1">
                    <local:DelayedLoadingRegion.Body>
                      <Grid Padding="12" RowSpacing="12">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                          x:Name="EntryHeaderBand"
                          Grid.Row="0"
                          Style="{StaticResource ListHeaderBandStyle}"
                        >
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="152" />
                              <ColumnDefinition x:Name="ChangeHeaderColumn" Width="0" />
                              <ColumnDefinition x:Name="EntryActionsHeaderColumn" Width="66" />
                            </Grid.ColumnDefinitions>
                            <Button
                              x:Uid="Main_EntryNameHeader"
                              x:Name="EntryNameHeader"
                              Padding="60,6,6,6"
                              Tag="Name"
                              Click="OnEntrySort"
                              Style="{StaticResource ColumnHeaderButtonStyle}"
                            />
                            <Button
                              x:Uid="Main_SizeColumnText"
                              Grid.Column="1"
                              x:Name="SizeColumnText"
                              Padding="6"
                              HorizontalContentAlignment="Right"
                              Tag="Size"
                              Click="OnEntrySort"
                              Style="{StaticResource ColumnHeaderButtonStyle}"
                            >
                              <ToolTipService.ToolTip>
                                <ToolTip>
                                  <TextBlock
                                    x:Uid="Main_SizeAccounting"
                                    TextWrapping="Wrap"
                                    MaxWidth="360"
                                  />
                                </ToolTip>
                              </ToolTipService.ToolTip>
                            </Button>
                            <Button
                              x:Uid="Main_ChangeHeader"
                              x:Name="ChangeHeader"
                              HorizontalContentAlignment="Right"
                              Grid.Column="2"
                              Padding="6"
                              Visibility="Collapsed"
                              Tag="Change"
                              Click="OnEntrySort"
                              Style="{StaticResource ColumnHeaderButtonStyle}"
                            />
                          </Grid>
                        </Border>
                        <ListView
                          x:Name="Entries"
                          ItemContainerStyle="{StaticResource ListRowContainerStyle}"
                          Grid.Row="1"
                          DoubleTapped="OnEntryInvoked"
                          ContextRequested="OnEntryContextRequested"
                          SelectionMode="Single"
                        >
                          <ListView.ItemTemplate>
                            <DataTemplate
                              x:DataType="local:EntryRow"
                              xmlns:local="using:Something.App"
                            >
                              <Grid ColumnSpacing="12" Padding="0,8">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="32" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="140" />
                                  <ColumnDefinition Width="{x:Bind ComparisonWidth}" />
                                  <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <local:FileAttributeIcon
                                  x:Name="EntryAttributeIcon"
                                  IsDirectory="{x:Bind Entry.IsDirectory}"
                                  IsHidden="{x:Bind IsHidden}"
                                  IsSystem="{x:Bind IsSystem}"
                                  AttributesKnown="{x:Bind AttributesKnown}"
                                  VerticalAlignment="Center"
                                />
                                <TextBlock
                                  x:Name="EntryNameText"
                                  Grid.Column="1"
                                  Text="{x:Bind Name}"
                                  TextDecorations="{x:Bind local:RowDecoration.FromRemoved(Removal.IsRemoved), Mode=OneWay}"
                                  TextTrimming="CharacterEllipsis"
                                  ToolTipService.ToolTip="{x:Bind NameDescription}"
                                />
                                <TextBlock
                                  Grid.Column="2"
                                  x:Name="EntrySizeText"
                                  HorizontalAlignment="Right"
                                  Text="{x:Bind Size}"
                                  TextDecorations="{x:Bind local:RowDecoration.FromRemoved(Removal.IsRemoved), Mode=OneWay}"
                                  ToolTipService.ToolTip="{x:Bind SizeDescription}"
                                />
                                <TextBlock
                                  Grid.Column="3"
                                  HorizontalAlignment="Right"
                                  Text="{x:Bind Delta}"
                                  TextDecorations="{x:Bind local:RowDecoration.FromRemoved(Removal.IsRemoved), Mode=OneWay}"
                                  ToolTipService.ToolTip="{x:Bind SizeDescription}"
                                />
                                <Button
                                  x:Uid="Main_RecycleButton"
                                  x:Name="RecycleEntryButton"
                                  Grid.Column="4"
                                  Width="32"
                                  Height="32"
                                  Padding="6"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  IsEnabled="{x:Bind Removal.CanRecycle, Mode=OneWay}"
                                  Visibility="{x:Bind RecycleVisibility}"
                                  Click="OnRecycleEntry"
                                  DoubleTapped="OnRecycleDoubleTapped"
                                >
                                  <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                </Button>
                              </Grid>
                            </DataTemplate>
                          </ListView.ItemTemplate>
                        </ListView>
                      </Grid>
                    </local:DelayedLoadingRegion.Body>
                  </local:DelayedLoadingRegion>
                </Grid>
                <local:DelayedLoadingRegion
                  x:Name="RankingLoadingRegion"
                  Visibility="Collapsed"
                  Grid.Row="1"
                >
                  <local:DelayedLoadingRegion.Body>
                    <Grid Padding="12" RowSpacing="12">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                          <CheckBox
                            x:Uid="Main_AnalysisFoldersOnlyBox"
                            x:Name="AnalysisFoldersOnlyBox"
                            IsChecked="True"
                            Checked="OnAnalysisFoldersOnlyChanged"
                            Unchecked="OnAnalysisFoldersOnlyChanged"
                          />
                          <CheckBox
                            x:Uid="Main_LeafBox"
                            x:Name="LeafBox"
                            Checked="OnLeafChanged"
                            Unchecked="OnLeafChanged"
                            VerticalAlignment="Bottom"
                          />
                        </StackPanel>
                        <TextBlock
                          x:Name="AnalysisCountText"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          AutomationProperties.LiveSetting="Polite"
                        />
                      </Grid>
                      <Border
                        x:Name="AnalysisHeaderBand"
                        Grid.Row="1"
                        Style="{StaticResource ListHeaderBandStyle}"
                      >
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="152" />
                            <ColumnDefinition x:Name="RankingChangeColumn" Width="0" />
                            <ColumnDefinition x:Name="AnalysisActionsHeaderColumn" Width="66" />
                          </Grid.ColumnDefinitions>
                          <Button
                            x:Uid="Main_AnalysisNameHeader"
                            x:Name="AnalysisNameHeader"
                            Padding="60,6,6,6"
                            Tag="Name"
                            Click="OnAnalysisSort"
                            Style="{StaticResource ColumnHeaderButtonStyle}"
                          />
                          <Button
                            x:Uid="Main_ChangeHeader"
                            x:Name="RankingChangeHeader"
                            HorizontalContentAlignment="Right"
                            Grid.Column="2"
                            Padding="6"
                            Visibility="Collapsed"
                            Tag="Change"
                            Click="OnAnalysisSort"
                            Style="{StaticResource ColumnHeaderButtonStyle}"
                          />
                          <Button
                            x:Uid="Main_AnalysisSizeHeader"
                            x:Name="AnalysisSizeHeader"
                            HorizontalContentAlignment="Right"
                            Grid.Column="1"
                            Padding="6"
                            Tag="Size"
                            Click="OnAnalysisSort"
                            Style="{StaticResource ColumnHeaderButtonStyle}"
                          >
                            <ToolTipService.ToolTip>
                              <ToolTip>
                                <TextBlock
                                  x:Uid="Main_SizeAccounting"
                                  TextWrapping="Wrap"
                                  MaxWidth="360"
                                />
                              </ToolTip>
                            </ToolTipService.ToolTip>
                          </Button>
                        </Grid>
                      </Border>
                      <ListView
                        x:Name="Ranking"
                        ItemContainerStyle="{StaticResource ListRowContainerStyle}"
                        Grid.Row="2"
                        DoubleTapped="OnRankInvoked"
                        ContextRequested="OnRankContextRequested"
                      >
                        <ListView.ItemTemplate>
                          <DataTemplate
                            x:DataType="local:RankingRow"
                            xmlns:local="using:Something.App"
                          >
                            <Grid Padding="0,8" ColumnSpacing="12">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="{x:Bind ComparisonWidth}" />
                                <ColumnDefinition Width="36" />
                              </Grid.ColumnDefinitions>
                              <local:FileAttributeIcon
                                x:Name="AnalysisAttributeIcon"
                                IsDirectory="{x:Bind IsDirectory}"
                                IsHidden="{x:Bind IsHidden}"
                                IsSystem="{x:Bind IsSystem}"
                                AttributesKnown="{x:Bind AttributesKnown}"
                                VerticalAlignment="Center"
                              />
                              <TextBlock
                                x:Name="AnalysisPathText"
                                Grid.Column="1"
                                Text="{x:Bind Path}"
                                TextDecorations="{x:Bind local:RowDecoration.FromRemoved(Removal.IsRemoved), Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind Path}"
                              />
                              <TextBlock
                                Grid.Column="2"
                                x:Name="AnalysisSizeText"
                                HorizontalAlignment="Right"
                                Text="{x:Bind Size}"
                                TextDecorations="{x:Bind local:RowDecoration.FromRemoved(Removal.IsRemoved), Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind SizeDescription}"
                              />
                              <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                Text="{x:Bind Delta}"
                                TextDecorations="{x:Bind local:RowDecoration.FromRemoved(Removal.IsRemoved), Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind SizeDescription}"
                              />
                              <Button
                                x:Uid="Main_RecycleButton"
                                x:Name="RecycleAnalysisButton"
                                Grid.Column="4"
                                Width="32"
                                Height="32"
                                Padding="6"
                                BorderThickness="0"
                                Background="Transparent"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                IsEnabled="{x:Bind Removal.CanRecycle, Mode=OneWay}"
                                Visibility="{x:Bind RecycleVisibility}"
                                Click="OnRecycleAnalysis"
                                DoubleTapped="OnRecycleDoubleTapped"
                              >
                                <FontIcon Glyph="&#xE74D;" FontSize="16" />
                              </Button>
                            </Grid>
                          </DataTemplate>
                        </ListView.ItemTemplate>
                      </ListView>
                    </Grid>
                  </local:DelayedLoadingRegion.Body>
                </local:DelayedLoadingRegion>
              </Grid>
            </Grid>
            <TextBlock
              x:Uid="Main_EmptyScanText"
              x:Name="EmptyScanText"
              Grid.Row="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              IsHitTestVisible="False"
            />
          </Grid>
        </ContentControl>
        <Border
          x:Name="ViewLoadingOverlay"
          Grid.Row="2"
          Grid.RowSpan="2"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          Visibility="Collapsed"
        >
          <StackPanel
            x:Name="ViewLoadingContent"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Opacity="0"
          >
            <local:RecordLoadingAnimation x:Name="ViewLoadingAnimation" />
            <TextBlock
              x:Uid="Main_ViewLoadingTitle"
              x:Name="ViewLoadingTitle"
              FontSize="18"
              FontWeight="SemiBold"
              HorizontalAlignment="Center"
            />
            <TextBlock
              x:Name="ViewLoadingText"
              HorizontalAlignment="Center"
              TextWrapping="Wrap"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              AutomationProperties.LiveSetting="Polite"
            />
            <TextBlock
              x:Uid="Main_ViewLoadingHint"
              x:Name="ViewLoadingHint"
              FontSize="12"
              HorizontalAlignment="Center"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            />
          </StackPanel>
        </Border>
        <InfoBar
          x:Name="MessageBar"
          Style="{StaticResource ToastStyle}"
          Grid.RowSpan="4"
          Canvas.ZIndex="20"
          IsOpen="False"
          AutomationProperties.LiveSetting="Polite"
        >
          <InfoBar.Resources>
            <ResourceDictionary Source="Styles/ToastPalette.xaml" />
          </InfoBar.Resources>
        </InfoBar>
      </Grid>
    </ContentControl>
    <Border
      x:Name="StartupOverlay"
      Grid.RowSpan="2"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      Padding="32"
    >
      <Grid VerticalAlignment="Center" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="210" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Spacing="20">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Image Source="ms-appx:///Assets/app-icon.png" Width="36" Height="36" />
            <TextBlock
              Text="Something"
              FontSize="28"
              FontWeight="SemiBold"
              VerticalAlignment="Center"
            />
          </StackPanel>
          <TextBlock
            x:Uid="Main_StartupText"
            x:Name="StartupText"
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            AutomationProperties.LiveSetting="Polite"
          />
        </StackPanel>
        <Viewbox Grid.Column="1" Width="210" VerticalAlignment="Center">
          <local:RecordLoadingAnimation x:Name="StartupAnimation" />
        </Viewbox>
      </Grid>
    </Border>
  </Grid>
</Window>
