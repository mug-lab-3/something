root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
max_line_length = 100
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

[*.{json,csproj,props,slnx}]
indent_style = space
indent_size = 2

[*.{config,csproj,props,slnx,targets,xaml,xml}]
indent_style = space
indent_size = 2
max_line_length = 100
